@inherits LayoutComponentBase

@if (_initialLoad)
{
    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">@L["common.loading"]</span></div>
    </div>
}
else if (!Auth.IsAuthenticated)
{
    @Body
}
else
{
    <a href="#main-content" class="visually-hidden-focusable sh-skip-link">@L["nav.skip"]</a>

    <div class="sh-shell">
        <aside class="sh-sidebar" aria-label="@L["nav.main"]">
            <a class="sh-brand" href="/" aria-label="@L["app.name"] – @L["nav.dashboard"]">
                @if (!string.IsNullOrEmpty(Branding.LogoDataUrl))
                {
                    <img src="@Branding.LogoDataUrl" class="logo-light" alt="@L["app.name"]" />
                    <img src="@(string.IsNullOrEmpty(Branding.LogoDarkDataUrl) ? Branding.LogoDataUrl : Branding.LogoDarkDataUrl)" class="logo-dark" alt="@L["app.name"]" />
                }
                else
                {
                    <svg class="sh-logo-mark" width="30" height="30" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12.5" fill="none" stroke="var(--sh-accent)" stroke-width="5"></circle><circle cx="16" cy="16" r="4.5" fill="currentColor"></circle></svg>
                    <span>@L["app.name"]</span>
                }
            </a>

            @if (Project.CurrentProject != null)
            {
                <div class="dropdown">
                    <button class="sh-project-switch dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="overflow-hidden">
                            <span class="sh-label">@L["nav.project"]</span>
                            <span class="sh-value">@Project.CurrentProject.Name</span>
                        </span>
                        <i class="bi bi-chevron-expand text-muted" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu w-100">
                        @foreach (var p in _projects)
                        {
                            <li>
                                <button type="button" class="dropdown-item @(p.Id == Project.CurrentProject?.Id ? "active" : "")" @onclick="() => SwitchProjectAsync(p)">
                                    <span class="flex-grow-1 text-truncate">@p.Name</span>
                                    @if (p.Id == Project.CurrentProject?.Id) { <i class="bi bi-check-lg" aria-hidden="true"></i> }
                                </button>
                            </li>
                        }
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/projects"><i class="bi bi-gear" aria-hidden="true"></i>@L["project.title"]</a></li>
                    </ul>
                </div>
            }

            <AppNav />

            <div class="sh-sidebar-footer">
                <ThemeToggle />
                <LanguageSelector />
                <div class="dropup">
                    <button class="sh-user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="sh-avatar" aria-hidden="true">@Initials</span>
                        <span class="d-flex flex-column overflow-hidden">
                            <span class="fw-semibold text-truncate">@Auth.CurrentUser?.Username</span>
                            <span class="small text-muted text-truncate">@Auth.CurrentUser?.Email</span>
                        </span>
                        <i class="bi bi-three-dots-vertical ms-auto text-muted" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu w-100">
                        <li><a class="dropdown-item" href="/settings/account"><i class="bi bi-person-gear" aria-hidden="true"></i>@L["nav.settings.account"]</a></li>
                        <li><a class="dropdown-item" href="/settings/password"><i class="bi bi-key" aria-hidden="true"></i>@L["auth.change.password"]</a></li>
                        <li><a class="dropdown-item" href="/settings/notifications"><i class="bi bi-bell" aria-hidden="true"></i>@L["settings.notifications.title"]</a></li>
                        <li><a class="dropdown-item" href="/webhooks"><i class="bi bi-broadcast-pin" aria-hidden="true"></i>@L["nav.webhooks"]</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button type="button" class="dropdown-item text-danger" @onclick="LogoutAsync"><i class="bi bi-box-arrow-right" aria-hidden="true"></i>@L["nav.logout"]</button></li>
                    </ul>
                </div>
            </div>
        </aside>

        <div class="sh-content">
            <header class="sh-topbar">
                <a class="sh-brand d-lg-none px-0" href="/" aria-label="@L["app.name"] – @L["nav.dashboard"]">
                    @if (!string.IsNullOrEmpty(Branding.LogoDataUrl))
                    {
                        <img src="@Branding.LogoDataUrl" class="logo-light" alt="@L["app.name"]" style="max-width:110px" />
                        <img src="@(string.IsNullOrEmpty(Branding.LogoDarkDataUrl) ? Branding.LogoDataUrl : Branding.LogoDarkDataUrl)" class="logo-dark" alt="@L["app.name"]" style="max-width:110px" />
                    }
                    else
                    {
                        <svg class="sh-logo-mark" width="30" height="30" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12.5" fill="none" stroke="var(--sh-accent)" stroke-width="5"></circle><circle cx="16" cy="16" r="4.5" fill="currentColor"></circle></svg>
                    }
                </a>

                <form class="sh-search" role="search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <label for="sh-search-input" class="visually-hidden">@L["nav.search"]</label>
                    <input id="sh-search-input" type="search" placeholder="@L["nav.search.placeholder"]" @bind="_search" autocomplete="off" />
                    <kbd class="sh-kbd" aria-hidden="true">Ctrl K</kbd>
                </form>

                <div class="sh-topbar-actions">
                    <a class="btn btn-outline-secondary d-none d-md-inline-flex" href="/tags/read">
                        <i class="bi bi-broadcast" aria-hidden="true"></i>@L["nav.scan"]
                    </a>
                    <a class="btn btn-primary d-none d-sm-inline-flex" href="/spools/new">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i><span class="d-none d-xl-inline">@L["spool.add"]</span>
                    </a>
                    <a class="sh-icon-btn d-sm-none" href="/spools/new" aria-label="@L["spool.add"]">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    </a>
                </div>
            </header>

            <main id="main-content" class="sh-main" tabindex="-1">
                <div @key="_languageKey">@Body</div>
            </main>

            <footer class="sh-footer">
                <a href="/changelog">@L["nav.changelog"]</a>
                <a href="/privacy">@L["legal.privacy.title"]</a>
                <a href="/imprint">@L["legal.imprint.title"]</a>
                <a href="/terms">@L["legal.terms.title"]</a>
            </footer>
        </div>
    </div>

    <nav class="sh-bottomnav" aria-label="@L["mobile.quick.actions"]">
        <NavLink class="sh-bottomnav-link" href="/" Match="NavLinkMatch.All">
            <i class="bi bi-house" aria-hidden="true"></i><span>@L["nav.dashboard"]</span>
        </NavLink>
        <NavLink class="sh-bottomnav-link" href="/spools">
            <i class="bi bi-record-circle" aria-hidden="true"></i><span>@L["nav.spools"]</span>
        </NavLink>
        <NavLink class="sh-bottomnav-scan" href="/tags/read" aria-label="@L["nav.scan"]">
            <i class="bi bi-broadcast" aria-hidden="true"></i>
        </NavLink>
        <NavLink class="sh-bottomnav-link" href="/overview">
            <i class="bi bi-geo-alt" aria-hidden="true"></i><span>@L["nav.group.locations"]</span>
        </NavLink>
        <button type="button" class="sh-bottomnav-link" data-bs-toggle="offcanvas" data-bs-target="#navOffcanvas" aria-controls="navOffcanvas">
            <i class="bi bi-list" aria-hidden="true"></i><span>@L["nav.more"]</span>
        </button>
    </nav>

    <div class="offcanvas offcanvas-end" id="navOffcanvas" tabindex="-1" aria-labelledby="navOffcanvasLabel">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title h5 mb-0" id="navOffcanvasLabel">@L["nav.menu"]</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@L["common.close"]"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column gap-3">
            @if (Project.CurrentProject != null)
            {
                <div class="dropdown">
                    <button class="sh-project-switch dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="overflow-hidden">
                            <span class="sh-label">@L["nav.project"]</span>
                            <span class="sh-value">@Project.CurrentProject.Name</span>
                        </span>
                        <i class="bi bi-chevron-expand text-muted" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu w-100">
                        @foreach (var p in _projects)
                        {
                            <li>
                                <button type="button" class="dropdown-item @(p.Id == Project.CurrentProject?.Id ? "active" : "")" @onclick="() => SwitchFromMenuAsync(p)">
                                    <span class="flex-grow-1 text-truncate">@p.Name</span>
                                </button>
                            </li>
                        }
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/projects" @onclick="CloseOffcanvas"><i class="bi bi-gear" aria-hidden="true"></i>@L["project.title"]</a></li>
                    </ul>
                </div>
            }

            <AppNav OnNavigate="CloseOffcanvas" />

            <div class="sh-nav">
                <div class="sh-nav-section">@L["nav.group.account"]</div>
                <a class="sh-nav-link" href="/settings/account" @onclick="CloseOffcanvas"><i class="bi bi-person-gear" aria-hidden="true"></i>@L["nav.settings.account"]</a>
                <a class="sh-nav-link" href="/settings/password" @onclick="CloseOffcanvas"><i class="bi bi-key" aria-hidden="true"></i>@L["auth.change.password"]</a>
                <a class="sh-nav-link" href="/settings/notifications" @onclick="CloseOffcanvas"><i class="bi bi-bell" aria-hidden="true"></i>@L["settings.notifications.title"]</a>
                <a class="sh-nav-link" href="/webhooks" @onclick="CloseOffcanvas"><i class="bi bi-broadcast-pin" aria-hidden="true"></i>@L["nav.webhooks"]</a>
                <a class="sh-nav-link" href="/changelog" @onclick="CloseOffcanvas"><i class="bi bi-stars" aria-hidden="true"></i>@L["nav.changelog"]</a>
            </div>

            <ThemeToggle />
            <LanguageSelector />

            <button type="button" class="btn btn-outline-danger w-100" @onclick="LogoutAsync">
                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>@L["nav.logout"]
            </button>
        </div>
    </div>

    @if (_showCookieBanner)
    {
        <div class="position-fixed bottom-0 start-0 end-0 p-3" style="z-index:1060">
            <div class="sh-card d-flex align-items-center gap-3 flex-wrap mx-auto" style="max-width:960px;box-shadow:var(--sh-shadow-lg)">
                <span class="flex-grow-1 small">@L["cookie.banner.text"] <a href="/privacy">@L["legal.privacy.title"]</a></span>
                <button class="btn btn-primary btn-sm" @onclick="DismissCookieBanner">@L["cookie.banner.ok"]</button>
            </div>
        </div>
    }
}

@page "/webhooks"

<PageTitle>@L["webhook.title"] – @L["app.name"]</PageTitle>

<div class="page-header">
    <div>
        <h1>@L["webhook.title"]</h1>
        <p class="page-subtitle">@L.Format("webhook.subtitle", Project.CurrentProject?.Name ?? "")</p>
    </div>
    @if (!_loading && !_loadError && _webhooks.Count > 0)
    {
        <div class="page-actions">
            <button type="button" class="btn btn-primary" @onclick="ShowAdd">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>@L["webhook.add"]
            </button>
        </div>
    }
</div>

@if (_loading)
{
    <div class="text-center py-5" role="status">
        <div class="spinner-border text-primary" aria-hidden="true"></div>
        <span class="visually-hidden">@L["common.loading"]</span>
    </div>
}
else if (_loadError)
{
    <div class="alert alert-danger d-flex flex-wrap align-items-center gap-2" role="alert">
        <span class="flex-grow-1">@L["webhook.load.error"]</span>
        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="LoadAsync">@L["place.retry"]</button>
    </div>
}
else if (_webhooks.Count == 0)
{
    <div class="sh-empty">
        <i class="bi bi-broadcast-pin" aria-hidden="true"></i>
        <h2>@L["webhook.empty"]</h2>
        <p>@L["webhook.empty.text"]</p>
        <button type="button" class="btn btn-primary" @onclick="ShowAdd">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>@L["webhook.add"]
        </button>
    </div>
}
else
{
    @if (_notice != null)
    {
        <div class="alert @(_noticeSuccess ? "alert-success" : "alert-danger") d-flex align-items-start gap-2" role="status">
            <span class="flex-grow-1 text-break">@_notice</span>
            <button type="button" class="btn-close" aria-label="@L["common.close"]" @onclick="() => _notice = null"></button>
        </div>
    }

    <div class="wh-grid">
        @foreach (var w in _webhooks)
        {
            var failed = w.LastTriggeredAt != null && w.LastSuccess != true;
            <article class="sh-card wh-card @(w.IsEnabled ? "" : "is-paused") @(failed ? "is-failed" : "")" aria-labelledby="wh-@w.Id">
                <div class="wh-head">
                    <span class="wh-type-icon" aria-hidden="true"><i class="bi @TypeIcon(w.Type)"></i></span>
                    <div class="wh-title">
                        <h2 class="sh-card-title" id="wh-@w.Id">@w.Name</h2>
                        <p class="sh-card-sub">@TypeLabel(w.Type)</p>
                    </div>
                    @if (w.IsEnabled)
                    {
                        <span class="sh-chip sh-chip-sm sh-chip-ok">@L["webhook.enabled"]</span>
                    }
                    else
                    {
                        <span class="sh-chip sh-chip-sm">@L["webhook.paused"]</span>
                    }
                </div>

                <p class="wh-target font-monospace" title="@TargetLabel(w)">@TargetLabel(w)</p>

                <div>
                    <span class="wh-label">@L["webhook.events"]</span>
                    <div class="d-flex flex-wrap gap-1">
                        @if (w.OnDryerFinished) { <span class="sh-chip sh-chip-sm"><i class="bi bi-thermometer-sun" aria-hidden="true"></i>@L["webhook.event.dryer.finished"]</span> }
                        @if (w.OnSpoolLow) { <span class="sh-chip sh-chip-sm"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i>@L["webhook.event.spool.low"]</span> }
                        @if (w.OnSpoolConsumed) { <span class="sh-chip sh-chip-sm"><i class="bi bi-archive" aria-hidden="true"></i>@L["webhook.event.spool.consumed"]</span> }
                        @if (!w.OnDryerFinished && !w.OnSpoolLow && !w.OnSpoolConsumed) { <span class="small text-muted">@L["webhook.events.none"]</span> }
                    </div>
                </div>

                <div class="wh-status @(failed ? "is-failed" : "")">
                    @if (w.LastTriggeredAt == null)
                    {
                        <span class="text-muted"><i class="bi bi-dash-circle" aria-hidden="true"></i> @L["webhook.last.never"]</span>
                    }
                    else if (w.LastSuccess == true)
                    {
                        <span class="text-success"><i class="bi bi-check-circle" aria-hidden="true"></i> @L["webhook.last.success"]</span>
                        <span class="text-muted">@FormatTime(w.LastTriggeredAt)@(w.LastStatusCode != null ? $" · HTTP {w.LastStatusCode}" : "")</span>
                    }
                    else
                    {
                        <span class="text-danger fw-semibold"><i class="bi bi-x-circle" aria-hidden="true"></i> @L["webhook.last.failed"]</span>
                        <span class="text-muted">@FormatTime(w.LastTriggeredAt)@(w.LastStatusCode != null ? $" · HTTP {w.LastStatusCode}" : "")</span>
                        @if (!string.IsNullOrEmpty(w.LastError))
                        {
                            <span class="wh-error">@w.LastError</span>
                        }
                        <span class="text-muted">@L["webhook.failed.hint"]</span>
                    }
                </div>

                @if (_testTargetId == w.Id && _testMessage != null && (_testSuccess || !failed))
                {
                    <div class="alert @(_testSuccess ? "alert-success" : "alert-danger") py-2 mb-0 small text-break" role="status">@_testMessage</div>
                }

                <div class="wh-actions">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => TestAsync(w)" disabled="@(_testingId == w.Id)">
                        @if (_testingId == w.Id) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                        else { <i class="bi bi-send" aria-hidden="true"></i> }
                        @L["webhook.test"]
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => ShowEdit(w)">
                        <i class="bi bi-pencil" aria-hidden="true"></i>@L["common.edit"]
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => ToggleEnabledAsync(w)" disabled="@(_togglingId == w.Id)">
                        <i class="bi @(w.IsEnabled ? "bi-pause-fill" : "bi-play-fill")" aria-hidden="true"></i>@(w.IsEnabled ? L["webhook.pause"] : L["webhook.resume"])
                    </button>
                    @if (IsAdmin)
                    {
                        <button type="button" class="btn btn-outline-danger wh-icon-btn" @onclick="() => AskDelete(w)"
                                aria-label="@L.Format("webhook.delete.for", w.Name)" title="@L["webhook.delete"]">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                        </button>
                    }
                </div>
            </article>
        }
    </div>
}

@if (_form != null)
{
    <div class="modal-backdrop-custom" @onclick="Cancel">
        <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="wh-form-title" @onclick:stopPropagation>
            <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <h5 id="wh-form-title" class="mb-3">@(_editId == null ? L["webhook.add"] : L["webhook.edit"])</h5>
                @if (_error != null)
                {
                    <div class="alert alert-danger py-2 small" role="alert">@_error</div>
                }

                <fieldset class="mb-3">
                    <legend class="form-label">@L["webhook.type"]</legend>
                    <div class="wh-types">
                        @foreach (var t in Types)
                        {
                            <button type="button" class="wh-type" aria-pressed="@(_form.Type == t ? "true" : "false")" @onclick="() => _form.Type = t">
                                <i class="bi @TypeIcon(t)" aria-hidden="true"></i>
                                <span>@TypeLabel(t)</span>
                            </button>
                        }
                    </div>
                </fieldset>

                <div class="mb-3">
                    <label class="form-label" for="wh-name">@L["webhook.name"]</label>
                    <input id="wh-name" class="form-control" @bind="_form.Name" @bind:event="oninput" maxlength="200" required
                           placeholder="@L["webhook.name.placeholder"]" autocomplete="off" />
                </div>

                @if (_form.Type == "telegram")
                {
                    <div class="mb-3">
                        <label class="form-label" for="wh-token">@L["webhook.telegram.token"]</label>
                        <input id="wh-token" class="form-control font-monospace" type="password" autocomplete="off" @bind="_form.BotToken"
                               placeholder="@(_editTokenMasked ?? "123456789:AA...")" aria-describedby="wh-token-hint" />
                        @if (_editTokenMasked != null)
                        {
                            <div class="form-text" id="wh-token-hint">@L["webhook.telegram.token.keep"]</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="wh-chat">@L["webhook.telegram.chat"]</label>
                        <input id="wh-chat" class="form-control font-monospace" @bind="_form.ChatId" placeholder="-1001234567890" aria-describedby="wh-chat-hint" autocomplete="off" />
                        <div class="form-text" id="wh-chat-hint">@L["webhook.telegram.chat.hint"]</div>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label" for="wh-url">@L["webhook.url"]</label>
                        <input id="wh-url" class="form-control font-monospace" type="url" @bind="_form.Url" placeholder="@UrlPlaceholder(_form.Type)"
                               aria-describedby="wh-url-hint" autocomplete="off" />
                        <div class="form-text" id="wh-url-hint">@UrlHint(_form.Type)</div>
                    </div>
                }

                <fieldset class="mb-3">
                    <legend class="form-label">@L["webhook.events"]</legend>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="whDryer" @bind="_form.OnDryerFinished" />
                        <label class="form-check-label" for="whDryer">@L["webhook.event.dryer.finished"]</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="whLow" @bind="_form.OnSpoolLow" />
                        <label class="form-check-label" for="whLow">@L["webhook.event.spool.low"]</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="whConsumed" @bind="_form.OnSpoolConsumed" />
                        <label class="form-check-label" for="whConsumed">@L["webhook.event.spool.consumed"]</label>
                    </div>
                </fieldset>

                <div class="form-check form-switch mb-3 wh-enabled">
                    <input class="form-check-input" type="checkbox" role="switch" id="whEnabled" @bind="_form.IsEnabled" />
                    <label class="form-check-label" for="whEnabled">@L["webhook.enabled.label"]</label>
                </div>

                <div class="d-flex gap-2 justify-content-end flex-wrap">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">@L["common.cancel"]</button>
                    <button type="submit" class="btn btn-primary" disabled="@(_saving || string.IsNullOrWhiteSpace(_form.Name))">
                        @if (_saving) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                        @L["common.save"]
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@if (_deleteTarget != null)
{
    <div class="modal-backdrop-custom" @onclick="() => { _deleteTarget = null; _deleteError = null; }">
        <div class="modal-box" role="alertdialog" aria-modal="true" aria-labelledby="wh-delete-title" @onclick:stopPropagation>
            <h5 id="wh-delete-title">@L["webhook.delete"]</h5>
            <p>@L.Format("webhook.delete.text", _deleteTarget.Name)</p>
            @if (_deleteError != null)
            {
                <div class="alert alert-danger py-2 small" role="alert">@_deleteError</div>
            }
            <div class="d-flex gap-2 justify-content-end flex-wrap">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => { _deleteTarget = null; _deleteError = null; }">@L["common.cancel"]</button>
                <button type="button" class="btn btn-danger" @onclick="DeleteAsync" disabled="@_deleting">
                    @if (_deleting) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                    @L["webhook.delete"]
                </button>
            </div>
        </div>
    </div>
}

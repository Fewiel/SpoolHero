@page "/webhooks"

<PageTitle>@L["webhook.title"] – @L["app.name"]</PageTitle>

<div class="page-header">
    <h1><i class="bi bi-broadcast-pin me-2"></i>@L["webhook.title"]</h1>
    <button class="btn btn-primary" @onclick="ShowAdd">
        <i class="bi bi-plus-lg me-1"></i>@L["webhook.add"]
    </button>
</div>

<p class="text-muted small">@L["webhook.hint"]</p>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border"></div></div>
}
else if (_webhooks.Count == 0 && _form == null)
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-broadcast-pin fs-1"></i>
        <p class="mt-2">@L["webhook.empty"]</p>
    </div>
}
else
{
    <div class="row g-3">
        @if (_form != null && _editId == null)
        {
            <div class="col-12 col-md-6 col-lg-4">
                @RenderForm()
            </div>
        }

        @foreach (var w in _webhooks)
        {
            <div class="col-12 col-md-6 col-lg-4">
                @if (_editId == w.Id && _form != null)
                {
                    @RenderForm()
                }
                else
                {
                    <div class="card h-100 @(w.IsEnabled ? "" : "opacity-75")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <h6 class="card-title mb-0">
                                    <i class="bi @TypeIcon(w.Type) me-1"></i>@w.Name
                                </h6>
                                @if (w.IsEnabled)
                                {
                                    <span class="badge text-bg-success">@L["webhook.enabled"]</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">@L["webhook.disabled"]</span>
                                }
                            </div>
                            <p class="text-muted small mb-2">@TypeLabel(w.Type)</p>
                            <p class="small mb-2 font-monospace text-truncate" title="@TargetLabel(w)">@TargetLabel(w)</p>

                            <div class="d-flex flex-wrap gap-1 mb-2">
                                @if (w.OnDryerFinished) { <span class="badge text-bg-light border"><i class="bi bi-thermometer-half me-1"></i>@L["webhook.event.dryer.finished"]</span> }
                                @if (w.OnSpoolLow) { <span class="badge text-bg-light border"><i class="bi bi-exclamation-triangle me-1"></i>@L["webhook.event.spool.low"]</span> }
                                @if (w.OnSpoolConsumed) { <span class="badge text-bg-light border"><i class="bi bi-archive me-1"></i>@L["webhook.event.spool.consumed"]</span> }
                            </div>

                            <div class="small mb-2">
                                @if (w.LastTriggeredAt == null)
                                {
                                    <span class="text-muted"><i class="bi bi-dash-circle me-1"></i>@L["webhook.last.never"]</span>
                                }
                                else if (w.LastSuccess == true)
                                {
                                    <span class="text-success"><i class="bi bi-check-circle me-1"></i>@L["webhook.last.success"]</span>
                                    <span class="text-muted ms-1">@FormatTime(w.LastTriggeredAt) @(w.LastStatusCode != null ? $"(HTTP {w.LastStatusCode})" : "")</span>
                                }
                                else
                                {
                                    <span class="text-danger"><i class="bi bi-x-circle me-1"></i>@L["webhook.last.failed"]</span>
                                    <span class="text-muted ms-1">@FormatTime(w.LastTriggeredAt)</span>
                                    @if (!string.IsNullOrEmpty(w.LastError))
                                    {
                                        <div class="text-danger text-break mt-1" style="font-size:.75rem">@w.LastError</div>
                                    }
                                }
                            </div>

                            @if (_testTargetId == w.Id && _testMessage != null)
                            {
                                <div class="alert @(_testSuccess ? "alert-success" : "alert-danger") py-1 mb-2 small text-break">@_testMessage</div>
                            }

                            <div class="d-flex gap-2 mt-2 flex-wrap">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ShowEdit(w)" title="@L["common.edit"]">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => TestAsync(w)" disabled="@(_testingId == w.Id)">
                                    @if (_testingId == w.Id)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-send me-1"></i>
                                    }
                                    @L["webhook.test"]
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => _deleteTarget = w" title="@L["common.delete"]">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@{ RenderFragment RenderForm() => __builder =>
{
    <div class="card h-100 border-primary">
        <div class="card-body">
            @if (_error != null) { <div class="alert alert-danger py-2 mb-2 small">@_error</div> }
            <div class="mb-2">
                <label class="form-label">@L["webhook.name"] *</label>
                <input class="form-control" @bind="_form!.Name" maxlength="200" />
            </div>
            <div class="mb-2">
                <label class="form-label">@L["webhook.type"]</label>
                <select class="form-select" @bind="_form!.Type">
                    <option value="discord">@L["webhook.type.discord"]</option>
                    <option value="telegram">@L["webhook.type.telegram"]</option>
                    <option value="homeassistant">@L["webhook.type.homeassistant"]</option>
                    <option value="generic">@L["webhook.type.generic"]</option>
                </select>
            </div>
            @if (_form!.Type == "telegram")
            {
                <div class="mb-2">
                    <label class="form-label">@L["webhook.telegram.token"] *</label>
                    <input class="form-control font-monospace" type="password" autocomplete="off" @bind="_form!.BotToken"
                           placeholder="@(_editTokenMasked ?? "123456789:AA...")" />
                    @if (_editTokenMasked != null)
                    {
                        <div class="form-text">@L["webhook.telegram.token.keep"]</div>
                    }
                </div>
                <div class="mb-2">
                    <label class="form-label">@L["webhook.telegram.chat"] *</label>
                    <input class="form-control font-monospace" @bind="_form!.ChatId" placeholder="-1001234567890" />
                    <div class="form-text">@L["webhook.telegram.chat.hint"]</div>
                </div>
            }
            else
            {
                <div class="mb-2">
                    <label class="form-label">@L["webhook.url"] *</label>
                    <input class="form-control font-monospace" type="url" @bind="_form!.Url" placeholder="@UrlPlaceholder(_form!.Type)" />
                    <div class="form-text">@UrlHint(_form!.Type)</div>
                </div>
            }
            <label class="form-label mt-1">@L["webhook.events"]</label>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="whDryer" @bind="_form!.OnDryerFinished" />
                <label class="form-check-label" for="whDryer">@L["webhook.event.dryer.finished"]</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="whLow" @bind="_form!.OnSpoolLow" />
                <label class="form-check-label" for="whLow">@L["webhook.event.spool.low"]</label>
            </div>
            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" id="whConsumed" @bind="_form!.OnSpoolConsumed" />
                <label class="form-check-label" for="whConsumed">@L["webhook.event.spool.consumed"]</label>
            </div>
            <hr class="my-2" />
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="whEnabled" @bind="_form!.IsEnabled" />
                <label class="form-check-label" for="whEnabled">@L["webhook.enabled"]</label>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@_saving">@L["common.save"]</button>
                <button class="btn btn-secondary btn-sm" @onclick="Cancel">@L["common.cancel"]</button>
            </div>
        </div>
    </div>
}; }

@if (_deleteTarget != null)
{
    <div class="modal-backdrop-custom" @onclick="() => _deleteTarget = null">
        <div class="modal-box" @onclick:stopPropagation>
            <h5>@L["webhook.delete"]</h5>
            <p>@L["webhook.delete.confirm"]</p>
            <p><strong>@_deleteTarget.Name</strong></p>
            @if (_deleteError != null) { <div class="alert alert-danger py-2 small">@_deleteError</div> }
            <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-secondary" @onclick="() => { _deleteTarget = null; _deleteError = null; }">@L["common.cancel"]</button>
                <button class="btn btn-danger" @onclick="DeleteAsync">@L["common.delete"]</button>
            </div>
        </div>
    </div>
}

@page "/tickets/{Id:guid}"
@page "/admin/tickets/{Id:guid}"

<PageTitle>@(_ticket?.Subject ?? L["ticket.title"]) – @L["app.name"]</PageTitle>

<div class="td-page">
    @if (_loading)
    {
        <div class="text-center py-5" role="status">
            <div class="spinner-border text-primary" aria-hidden="true"></div>
            <span class="visually-hidden">@L["common.loading"]</span>
        </div>
    }
    else if (_ticket == null)
    {
        <div class="sh-empty">
            <i class="bi bi-question-circle" aria-hidden="true"></i>
            <h2>@L["ticket.not.found"]</h2>
            <p>@L["ticket.not.found.text"]</p>
            <a class="btn btn-primary" href="@BackUrl">@L["ticket.back"]</a>
        </div>
    }
    else
    {
        <div class="page-header">
            <div class="min-w-0">
                <h1 class="text-break">@_ticket.Subject</h1>
                <p class="page-subtitle">@L.Format("ticket.detail.subtitle", _ticket.Username, TicketStatus.FormatDateTime(_ticket.CreatedAt))</p>
            </div>
            <div class="page-actions">
                <a href="@BackUrl" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>@L["ticket.back"]
                </a>
            </div>
        </div>

        <div class="td-status td-status-@_ticket.Status" role="status">
            <span class="sh-chip @TicketStatus.ChipClass(_ticket.Status)">
                <i class="bi @TicketStatus.Icon(_ticket.Status)" aria-hidden="true"></i>@TicketStatus.Label(L, _ticket.Status)
            </span>
            <span class="td-status-text">@TicketStatus.Explanation(L, _ticket.Status)</span>
            @if (_ticket.AssignedToUsername != null)
            {
                <span class="td-status-assignee"><i class="bi bi-person-check" aria-hidden="true"></i> @L["ticket.assigned.to"]: @_ticket.AssignedToUsername</span>
            }
        </div>

        @if (IsAdmin)
        {
            <section class="sh-card td-admin" aria-labelledby="td-admin-title">
                <h2 class="td-admin-title" id="td-admin-title"><i class="bi bi-shield-check" aria-hidden="true"></i> @L["ticket.admin.panel"]</h2>
                <div class="d-flex flex-wrap gap-2 align-items-end">
                    <div>
                        <label class="form-label" for="td-status-select">@L["ticket.status"]</label>
                        <select id="td-status-select" class="form-select" value="@_ticket.Status" @onchange="SetStatusAsync">
                            <option value="open">@L["ticket.status.open"]</option>
                            <option value="in_progress">@L["ticket.status.in_progress"]</option>
                            <option value="answered">@L["ticket.status.answered"]</option>
                            <option value="closed">@L["ticket.status.closed"]</option>
                        </select>
                    </div>
                    @if (_ticket.AssignedToUserId == Auth.CurrentUser?.Id)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="UnassignAsync">@L["admin.tickets.unassign"]</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="AssignMeAsync">@L["admin.tickets.assign.me"]</button>
                    }
                </div>
            </section>
        }

        <h2 class="sh-section-title mt-4">@L["ticket.conversation"]</h2>
        <ol class="td-thread">
            <li class="td-msg @(IsMine(_ticket.UserId) ? "is-mine" : "")">
                <div class="td-msg-head">
                    <span class="td-avatar" aria-hidden="true">@Initial(_ticket.Username)</span>
                    <span class="fw-semibold">@(IsMine(_ticket.UserId) ? L["ticket.you"] : _ticket.Username)</span>
                    <time class="td-time" datetime="@TicketStatus.AsLocal(_ticket.CreatedAt).ToString("o")">@TicketStatus.FormatDateTime(_ticket.CreatedAt)</time>
                </div>
                <div class="td-bubble">@_ticket.Description</div>
            </li>
            @foreach (var c in _ticket.Comments)
            {
                <li class="td-msg @(IsMine(c.UserId) ? "is-mine" : "") @(c.IsAdmin ? "is-team" : "") @(c.IsInternal ? "is-internal" : "")">
                    <div class="td-msg-head">
                        <span class="td-avatar" aria-hidden="true">@Initial(c.Username)</span>
                        <span class="fw-semibold">@(IsMine(c.UserId) ? L["ticket.you"] : c.Username)</span>
                        @if (c.IsInternal)
                        {
                            <span class="sh-chip sh-chip-sm sh-chip-warn"><i class="bi bi-lock" aria-hidden="true"></i>@L["ticket.reply.internal"]</span>
                        }
                        else if (c.IsAdmin)
                        {
                            <span class="sh-chip sh-chip-sm sh-chip-accent">@L["ticket.team"]</span>
                        }
                        <time class="td-time" datetime="@TicketStatus.AsLocal(c.CreatedAt).ToString("o")">@TicketStatus.FormatDateTime(c.CreatedAt)</time>
                    </div>
                    <div class="td-bubble">@c.Content</div>
                </li>
            }
        </ol>
        @if (_ticket.Comments.Count == 0)
        {
            <p class="td-waiting">@L["ticket.replies.none"]</p>
        }

        @if (_ticket.Status != "closed")
        {
            <section class="sh-card td-reply" aria-labelledby="td-reply-title">
                <form @onsubmit="SendReplyAsync" @onsubmit:preventDefault>
                    <label class="form-label" id="td-reply-title" for="td-reply-text">@L["ticket.reply.title"]</label>
                    <textarea id="td-reply-text" class="form-control mb-2" rows="4" @bind="_comment" @bind:event="oninput"
                              placeholder="@L["ticket.reply.placeholder"]" maxlength="5000"></textarea>
                    @if (IsAdmin)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="internalCheck" @bind="_isInternal" />
                            <label class="form-check-label" for="internalCheck">
                                @L["ticket.reply.internal"] <span class="text-muted">– @L["ticket.reply.internal.hint"]</span>
                            </label>
                        </div>
                    }
                    @if (_sendError != null)
                    {
                        <div class="alert alert-danger py-2" role="alert">@_sendError</div>
                    }
                    <div class="d-flex gap-2 justify-content-between flex-wrap">
                        @if (_ticket.UserId == Auth.CurrentUser?.Id)
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => _confirmClose = true">
                                <i class="bi bi-check2-circle" aria-hidden="true"></i>@L["ticket.close.solved"]
                            </button>
                        }
                        else
                        {
                            <span></span>
                        }
                        <button type="submit" class="btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(_comment) || _sending)">
                            @if (_sending) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                            else { <i class="bi bi-send" aria-hidden="true"></i> }
                            @L["ticket.send"]
                        </button>
                    </div>
                </form>
            </section>
        }
        else
        {
            <div class="sh-card td-closed">
                <p class="mb-2">@L["ticket.closed.hint"]</p>
                @if (!IsAdmin)
                {
                    <a class="btn btn-outline-secondary" href="/tickets"><i class="bi bi-plus-lg" aria-hidden="true"></i>@L["ticket.new"]</a>
                }
            </div>
        }
    }
</div>

@if (_confirmClose)
{
    <div class="modal-backdrop-custom" @onclick="() => _confirmClose = false">
        <div class="modal-box" role="alertdialog" aria-modal="true" aria-labelledby="td-close-title" @onclick:stopPropagation>
            <h5 id="td-close-title">@L["ticket.close"]</h5>
            <p>@L["ticket.close.confirm"]</p>
            <div class="d-flex gap-2 justify-content-end flex-wrap">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => _confirmClose = false">@L["common.cancel"]</button>
                <button type="button" class="btn btn-primary" @onclick="ConfirmCloseAsync">@L["ticket.close"]</button>
            </div>
        </div>
    </div>
}

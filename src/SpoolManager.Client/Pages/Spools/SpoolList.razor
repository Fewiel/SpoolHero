@page "/spools"
@using SpoolManager.Client.Helpers

<PageTitle>@L["spool.title"] – @L["app.name"]</PageTitle>

@{
    var list = Filtered;
}

<div class="page-header">
    <div>
        <h1>@L["spool.title"]</h1>
        <p class="page-subtitle">
            @if (_loading) { @L["common.loading"] }
            else { @SummaryText(list) }
        </p>
    </div>
    <div class="page-actions">
        <div class="sh-segmented" role="group" aria-label="@L["spool.view"]">
            <button type="button" aria-pressed="@(!_grouped ? "true" : "false")" @onclick="() => SetGrouped(false)">
                <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>@L["spool.view.spools"]
            </button>
            <button type="button" aria-pressed="@(_grouped ? "true" : "false")" @onclick="() => SetGrouped(true)">
                <i class="bi bi-collection" aria-hidden="true"></i>@L["spool.view.materials"]
            </button>
        </div>
        <a class="btn btn-primary d-none d-sm-inline-flex" href="/spools/new"><i class="bi bi-plus-lg" aria-hidden="true"></i>@L["spool.add"]</a>
    </div>
</div>

<div class="shelf-filters" role="search">
    <div class="shelf-filter-row">
        <div class="shelf-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <label for="spool-search" class="visually-hidden">@L["spool.search.label"]</label>
            <input id="spool-search" class="form-control" type="search" placeholder="@L["spool.search.placeholder"]"
                   value="@_search" @oninput="OnSearch" autocomplete="off" />
            @if (!string.IsNullOrEmpty(_search))
            {
                <button type="button" class="shelf-search-clear" aria-label="@L["spool.search.clear"]" @onclick="ClearSearch"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            }
        </div>
        <div class="sh-segmented" role="group" aria-label="@L["spool.filter.status"]">
            <button type="button" aria-pressed="@(_status == "active" ? "true" : "false")" @onclick='() => SetStatus("active")'>@L["spool.filter.active"]</button>
            <button type="button" aria-pressed="@(_status == "consumed" ? "true" : "false")" @onclick='() => SetStatus("consumed")'>@L["spool.filter.consumed"]</button>
            <button type="button" aria-pressed="@(_status == "all" ? "true" : "false")" @onclick='() => SetStatus("all")'>@L["spool.filter.all"]</button>
        </div>
    </div>

    <div class="shelf-filter-row">
        <div class="shelf-chips" role="group" aria-label="@L["spool.filter.type"]">
            <button type="button" class="sh-chip" aria-pressed="@(_type == "" ? "true" : "false")" @onclick='() => SetType("")'>@L["spool.filter.all.materials"]</button>
            @foreach (var t in Types)
            {
                var type = t;
                <button type="button" class="sh-chip" aria-pressed="@(string.Equals(_type, type, StringComparison.OrdinalIgnoreCase) ? "true" : "false")" @onclick="() => SetType(type)">@type</button>
            }
            @if (_type != "" && !Types.Contains(_type, StringComparer.OrdinalIgnoreCase))
            {
                <button type="button" class="sh-chip" aria-pressed="true" @onclick="() => SetType(_type)">@_type</button>
            }
            <button type="button" class="sh-chip @(LowCount > 0 && !_lowOnly ? "shelf-chip-warn" : "")" aria-pressed="@(_lowOnly ? "true" : "false")" @onclick="ToggleLow">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>@L["spool.filter.low"] · @LowCount
            </button>
        </div>
        <div class="shelf-selects">
            @if (_owners.Count > 0)
            {
                <label class="visually-hidden" for="spool-owner">@L["spool.owner"]</label>
                <select id="spool-owner" class="form-select" value="@_owner" @onchange="OnOwnerChanged">
                    <option value="">@L["spool.owner.all"]</option>
                    <option value="-">@L["spool.owner.none"]</option>
                    @foreach (var o in _owners)
                    {
                        <option value="@o">@o</option>
                    }
                </select>
            }
            <label class="visually-hidden" for="spool-location">@L["spool.location"]</label>
            <select id="spool-location" class="form-select" value="@_location" @onchange="OnLocationChanged">
                <option value="">@L["spool.location.all"]</option>
                <option value="none">@L["dashboard.no.location"]</option>
                @foreach (var loc in Locations)
                {
                    <option value="@loc.Key">@(loc.Kind switch { "printer" => L["spool.printer"], "storage" => L["spool.storage"], _ => L["spool.dryer"] }): @loc.Name</option>
                }
                @if (_location.Length > 2 && _location != "none" && Locations.All(l => l.Key != _location))
                {
                    <option value="@_location">@L["spool.location.selected"]</option>
                }
            </select>
            @if (!_grouped)
            {
                <label class="visually-hidden" for="spool-sort">@L["spool.sort"]</label>
                <select id="spool-sort" class="form-select" value="@_sort" @onchange="OnSortChanged">
                    <option value="low">@L["spool.sort.low"]</option>
                    <option value="new">@L["spool.sort.new"]</option>
                    <option value="name">@L["spool.sort.name"]</option>
                </select>
            }
        </div>
    </div>
</div>

@if (_actionError != null && _deleteTarget == null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <span class="flex-grow-1">@_actionError</span>
        <button type="button" class="btn-close" aria-label="@L["common.close"]" @onclick="() => _actionError = null"></button>
    </div>
}

@if (_nfcTarget != null && (_nfcWriting || _nfcMessage != null))
{
    <div class="alert @(_nfcWriting ? "alert-info" : _nfcSuccess ? "alert-success" : "alert-danger") d-flex align-items-center gap-2" role="status">
        @if (_nfcWriting)
        {
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span class="flex-grow-1">@L.Format("spool.nfc.writing.for", SpoolUi.Title(_nfcTarget))</span>
        }
        else
        {
            <span class="flex-grow-1">@SpoolUi.Title(_nfcTarget): @_nfcMessage</span>
            <button type="button" class="btn-close" aria-label="@L["common.close"]" @onclick="DismissNfc"></button>
        }
    </div>
}

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border" role="status"><span class="visually-hidden">@L["common.loading"]</span></div></div>
}
else if (_loadFailed)
{
    <div class="alert alert-danger d-flex align-items-center gap-3 flex-wrap" role="alert">
        <span class="flex-grow-1">@L["spool.list.load.error"]</span>
        <button type="button" class="btn btn-outline-danger" @onclick="ReloadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i>@L["common.retry"]</button>
    </div>
}
else if (list.Count == 0 && !HasFilters)
{
    <div class="sh-empty">
        <i class="bi bi-record-circle" aria-hidden="true"></i>
        <h2>@L["spool.list.empty.title"]</h2>
        <p>@L["spool.list.empty.text"]</p>
        <div class="d-flex gap-2 flex-wrap justify-content-center mt-2">
            <a class="btn btn-primary" href="/spools/new"><i class="bi bi-plus-lg" aria-hidden="true"></i>@L["spool.add"]</a>
            <a class="btn btn-outline-secondary" href="/tags/read"><i class="bi bi-broadcast" aria-hidden="true"></i>@L["nav.scan"]</a>
        </div>
    </div>
}
else if (list.Count == 0)
{
    <div class="sh-empty">
        <i class="bi bi-funnel" aria-hidden="true"></i>
        <h2>@L["spool.list.nomatch.title"]</h2>
        <p>@L["spool.list.nomatch.text"]</p>
        <button type="button" class="btn btn-primary mt-2" @onclick="ResetFilters"><i class="bi bi-x-circle" aria-hidden="true"></i>@L["spool.filter.reset"]</button>
    </div>
}
else if (_grouped)
{
    @foreach (var section in Sections(list))
    {
        <section class="shelf-section" aria-label="@section.Type">
            <div class="shelf-section-head">
                <h2 class="sh-section-title">@section.Type</h2>
                <span class="text-muted">@GroupMeta(section.SpoolCount, section.TotalGrams)</span>
            </div>
            <div class="shelf-material-grid">
                @foreach (var m in section.Materials)
                {
                    <article class="sh-card shelf-material">
                        <div class="d-flex align-items-center gap-3">
                            <SpoolRing ColorHex="@m.ColorHex" Percent="m.Percent" Size="64"
                                       AriaLabel="@L.Format("spool.ring.label", m.ColorName ?? m.Type, SpoolUi.Percent(m.Percent))">
                                <span>@((int)Math.Round(m.Percent))<small>%</small></span>
                            </SpoolRing>
                            <div class="min-w-0">
                                <h3 class="shelf-material-title">@(m.ColorName ?? "#" + m.ColorHex)</h3>
                                <div class="small text-muted text-truncate">@m.Brand @m.Type</div>
                                <div><span class="fw-semibold">@SpoolUi.Weight(m.TotalGrams)</span> <span class="small text-muted">· @(m.Spools.Count == 1 ? L["overview.place.one"] : L.Format("overview.place.many", m.Spools.Count))</span></div>
                            </div>
                        </div>
                        <ul class="list-unstyled mb-0 shelf-material-spools">
                            @foreach (var s in m.Spools)
                            {
                                <li>
                                    <a href="/spools/@s.Id" class="shelf-material-spool @(SpoolUi.IsLow(s) ? "is-low" : "")">
                                        <SpoolRing ColorHex="@s.MaterialColorHex" Percent="s.RemainingPercent" Size="32" />
                                        <span class="fw-semibold text-nowrap">@SpoolUi.Grams(s.RemainingWeightGrams)</span>
                                        <span class="text-muted text-truncate flex-grow-1">
                                            @if (s.ConsumedAt != null) { @L["spool.status.consumed"] }
                                            else if (SpoolUi.HasLocation(s)) { @SpoolUi.LocationName(s) }
                                            else { @L["dashboard.no.location"] }
                                        </span>
                                        @if (s.OwnerName != null)
                                        {
                                            <span class="sh-chip sh-chip-sm shelf-owner"><i class="bi bi-person" aria-hidden="true"></i>@s.OwnerName</span>
                                        }
                                        <span class="visually-hidden">#@SpoolUi.ShortId(s)</span>
                                    </a>
                                </li>
                            }
                        </ul>
                        <a class="btn btn-outline-secondary btn-sm align-self-start" href="/spools/new?material=@m.MaterialId">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i>@L["spool.add.same.material"]
                        </a>
                    </article>
                }
            </div>
        </section>
    }
}
else
{
    <div class="sh-tile-grid shelf-grid">
        @foreach (var spool in list)
        {
            var s = spool;
            var low = SpoolUi.IsLow(s);
            var dry = SpoolUi.GetDrying(s);
            <article class="sh-spool-tile shelf-tile @(low ? "sh-low" : "") @(s.ConsumedAt != null ? "sh-consumed" : "")">
                <div class="shelf-tile-top">
                    <SpoolRing ColorHex="@s.MaterialColorHex" Percent="s.RemainingPercent" Size="84"
                               AriaLabel="@L.Format("spool.ring.label", SpoolUi.Title(s), SpoolUi.Percent(s.RemainingPercent))">
                        <span>@((int)Math.Round(s.RemainingPercent))<small>%</small></span>
                    </SpoolRing>
                    <div class="dropdown shelf-menu">
                        <button type="button" class="btn btn-outline-secondary shelf-menu-btn" data-bs-toggle="dropdown" aria-expanded="false"
                                aria-label="@L.Format("spool.actions.for", SpoolUi.Title(s))">
                            <i class="bi bi-three-dots" aria-hidden="true"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/spools/@s.Id/edit"><i class="bi bi-pencil" aria-hidden="true"></i>@L["common.edit"]</a></li>
                            @if (_nfcAvailable && s.ConsumedAt == null)
                            {
                                <li><button type="button" class="dropdown-item" @onclick="() => FindSpoolAsync(s)"><i class="bi bi-search" aria-hidden="true"></i>@L["spool.find.title"]</button></li>
                                <li><button type="button" class="dropdown-item" @onclick="() => WriteNfcAsync(s)" disabled="@_nfcWriting"><i class="bi bi-broadcast" aria-hidden="true"></i>@L["tag.nfc.write"]</button></li>
                            }
                            <li><button type="button" class="dropdown-item" @onclick="() => Tags.DownloadSpoolBinAsync(s.Id)"><i class="bi bi-download" aria-hidden="true"></i>@L["tag.download.bin"]</button></li>
                            <li><button type="button" class="dropdown-item" @onclick="() => ShowSpoolJsonAsync(s)"><i class="bi bi-code" aria-hidden="true"></i>@L["tag.show.json"]</button></li>
                            <li><button type="button" class="dropdown-item" @onclick="() => CopyAsync(s)"><i class="bi bi-copy" aria-hidden="true"></i>@L["spool.duplicate"]</button></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><button type="button" class="dropdown-item text-danger" @onclick="() => ConfirmDelete(s)"><i class="bi bi-trash" aria-hidden="true"></i>@L["common.delete"]</button></li>
                        </ul>
                    </div>
                </div>
                <div class="min-w-0">
                    <a class="shelf-tile-title stretched-link" href="/spools/@s.Id">@SpoolUi.Title(s)</a>
                    <div class="small text-muted text-truncate">@s.MaterialBrand · @SpoolUi.Grams(s.RemainingWeightGrams)</div>
                </div>
                <div class="d-flex flex-wrap gap-1">
                    @if (s.ConsumedAt != null)
                    {
                        <span class="sh-chip sh-chip-sm">@L["spool.status.consumed"]</span>
                    }
                    else if (low)
                    {
                        <span class="sh-chip sh-chip-sm sh-chip-warn"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i>@L["dashboard.attention.low.kind"]</span>
                    }
                    @if (dry?.Done == true)
                    {
                        <span class="sh-chip sh-chip-sm sh-chip-ok">@L["spool.drying.finished"]</span>
                    }
                    @if (SpoolUi.HasLocation(s))
                    {
                        <span class="sh-chip sh-chip-sm shelf-chip-trunc"><i class="bi @SpoolUi.LocationIcon(s)" aria-hidden="true"></i>@SpoolUi.LocationName(s)</span>
                    }
                    else if (s.ConsumedAt == null)
                    {
                        <span class="sh-chip sh-chip-sm sh-chip-accent">@L["dashboard.no.location"]</span>
                    }
                    @if (s.OwnerName != null)
                    {
                        <span class="sh-chip sh-chip-sm shelf-chip-trunc"><i class="bi bi-person" aria-hidden="true"></i>@s.OwnerName</span>
                    }
                    <span class="sh-chip sh-chip-sm shelf-id" title="@L["spool.short.id"]">#@SpoolUi.ShortId(s)</span>
                </div>
                @if (dry is { Total: not null, Done: false })
                {
                    <div>
                        <div class="sh-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@dry.Percent"
                             aria-label="@L.Format("spool.drying.progress.label", SpoolUi.Title(s))">
                            <span class="sh-warn" style="width:@(dry.Percent)%"></span>
                        </div>
                        <div class="small text-muted mt-1">@L.Format("spool.drying.left", SpoolUi.Duration(dry.Remaining))</div>
                    </div>
                }
            </article>
        }
        <a class="sh-add-tile" href="/spools/new">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>@L["spool.add"]
        </a>
    </div>
}

@if (_deleteTarget != null)
{
    <div class="modal-backdrop-custom" @onclick="() => _deleteTarget = null">
        <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="delete-title" @onclick:stopPropagation>
            <h5 id="delete-title">@L["spool.delete"]</h5>
            <div class="d-flex align-items-center gap-3 my-3">
                <SpoolRing ColorHex="@_deleteTarget.MaterialColorHex" Percent="_deleteTarget.RemainingPercent" Size="48" />
                <div>
                    <div class="fw-semibold">@SpoolUi.FullTitle(_deleteTarget)</div>
                    <div class="small text-muted">@SpoolUi.Grams(_deleteTarget.RemainingWeightGrams) · #@SpoolUi.ShortId(_deleteTarget)</div>
                </div>
            </div>
            <p>@L["spool.delete.confirm.text"]</p>
            @if (_actionError != null)
            {
                <div class="alert alert-danger py-2">@_actionError</div>
            }
            <div class="d-flex gap-2 justify-content-end flex-wrap">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => _deleteTarget = null">@L["common.cancel"]</button>
                <button type="button" class="btn btn-danger" @onclick="DeleteAsync" disabled="@_deleting">
                    @if (_deleting) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                    <i class="bi bi-trash" aria-hidden="true"></i>@L["spool.delete.confirm.button"]
                </button>
            </div>
        </div>
    </div>
}

@if (_jsonTarget != null)
{
    <div class="modal-backdrop-custom" @onclick="CloseJson">
        <div class="modal-box shelf-json-box" role="dialog" aria-modal="true" aria-labelledby="json-title" @onclick:stopPropagation>
            <div class="d-flex align-items-start justify-content-between gap-2">
                <div>
                    <h5 id="json-title" class="mb-1">@L["tag.show.json"]</h5>
                    <p class="small text-muted mb-0">@SpoolUi.FullTitle(_jsonTarget) · #@SpoolUi.ShortId(_jsonTarget)</p>
                </div>
                <button type="button" class="btn-close" aria-label="@L["common.close"]" @onclick="CloseJson"></button>
            </div>
            @if (_jsonLoading)
            {
                <div class="text-center py-4"><div class="spinner-border" role="status"><span class="visually-hidden">@L["common.loading"]</span></div></div>
            }
            else
            {
                <pre class="shelf-json">@_jsonPayload</pre>
                <div class="d-flex gap-2 justify-content-end">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CopyJsonAsync">
                        <i class="bi @(_jsonCopied ? "bi-check-lg" : "bi-clipboard")" aria-hidden="true"></i>@(_jsonCopied ? L["common.copied"] : L["common.copy"])
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="CloseJson">@L["common.close"]</button>
                </div>
            }
        </div>
    </div>
}

@if (_findTarget != null)
{
    <FindSpoolModal @ref="_findModal" Spool="_findTarget" />
}

@page "/spools"

<PageTitle>@L["spool.title"] – @L["app.name"]</PageTitle>

<div class="page-header">
    <h1><i class="bi bi-archive me-2"></i>@L["spool.title"]</h1>
    <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/spools/new")'>
        <i class="bi bi-plus-lg me-1"></i>@L["spool.add"]
    </button>
</div>

<div class="row g-2 mb-3">
    <div class="col-12 col-md-6">
        <input class="form-control" placeholder="@L["spool.search"]" value="@_search" @oninput="OnSearch" />
    </div>
    <div class="col-auto">
        <select class="form-select" @bind="_filter" @bind:after="LoadAsync">
            <option value="">@L["spool.filter.all"]</option>
            <option value="active">@L["spool.filter.active"]</option>
            <option value="consumed">@L["spool.filter.consumed"]</option>
        </select>
    </div>
    @if (_owners.Count > 0)
    {
        <div class="col-auto">
            <select class="form-select" @bind="_owner" @bind:after="LoadAsync" aria-label="@L["spool.owner"]">
                <option value="">@L["spool.owner.all"]</option>
                <option value="-">@L["spool.owner.none"]</option>
                @foreach (var o in _owners)
                {
                    <option value="@o">@o</option>
                }
            </select>
        </div>
    }
    <div class="col-auto ms-md-auto">
        <div class="btn-group" role="group" aria-label="@L["spool.view"]">
            <button class="btn @(_grouped ? "btn-outline-secondary" : "btn-secondary")" title="@L["spool.view.spools"]" @onclick="() => SetGrouped(false)">
                <i class="bi bi-grid-3x3-gap"></i><span class="d-none d-lg-inline ms-1">@L["spool.view.spools"]</span>
            </button>
            <button class="btn @(_grouped ? "btn-secondary" : "btn-outline-secondary")" title="@L["spool.view.materials"]" @onclick="() => SetGrouped(true)">
                <i class="bi bi-collection"></i><span class="d-none d-lg-inline ms-1">@L["spool.view.materials"]</span>
            </button>
        </div>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border"></div></div>
}
else if (_spools.Count == 0)
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-archive fs-1"></i>
        <p class="mt-2">@L["common.none"]</p>
    </div>
}
else if (_grouped)
{
    <div class="row g-3">
        @foreach (var group in MaterialGroups)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="spool-card h-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="color-dot" style="background-color: #@group.ColorHex"></div>
                            <div>
                                <div class="fw-semibold">@group.Brand @group.Type</div>
                                <small class="text-muted">@(group.ColorName ?? "#" + group.ColorHex)</small>
                            </div>
                        </div>
                        <span class="badge bg-primary-subtle text-primary-emphasis">@group.Spools.Count× </span>
                    </div>
                    <div class="fs-5 fw-semibold">@group.TotalGrams.ToString("0.#") g</div>
                    @if (group.CapacityGrams > 0)
                    {
                        var pct = Math.Min(group.TotalGrams / group.CapacityGrams * 100, 100);
                        <div class="remaining-bar mb-1">
                            <div class="remaining-bar-fill @GetBarClass(pct)" style="width: @((int)pct)%"></div>
                        </div>
                    }
                    <ul class="list-unstyled small mb-0 mt-2">
                        @foreach (var spool in group.Spools)
                        {
                            <li class="d-flex align-items-center gap-2 py-1 border-top">
                                <a href="/spools/@spool.Id" class="font-monospace text-decoration-none" style="font-size:.7rem">#@spool.Id.ToString("N")[..5].ToUpper()</a>
                                <span>@spool.RemainingWeightGrams.ToString("0.#") g</span>
                                <span class="text-muted text-truncate">@LocationLabel(spool)</span>
                                @if (spool.OwnerName != null)
                                {
                                    <span class="badge text-bg-light border ms-auto text-truncate" style="max-width:40%"><i class="bi bi-person me-1"></i>@spool.OwnerName</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var spool in _spools)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="spool-card">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="color-dot" style="background-color: #@spool.MaterialColorHex"></div>
                            <div>
                                <div class="fw-semibold">@spool.MaterialBrand @spool.MaterialType</div>
                                <small class="text-muted">@(spool.MaterialColorName ?? "#" + spool.MaterialColorHex)</small>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="font-monospace text-muted" style="font-size:.7rem">#@spool.Id.ToString("N")[..5].ToUpper()</span>
                            <span class="badge @(spool.ConsumedAt != null ? "bg-secondary" : "bg-success") lifecycle-badge">
                                @(spool.ConsumedAt != null ? L["spool.status.consumed"] : L["spool.status.active"])
                            </span>
                        </div>
                    </div>

                    <div class="remaining-bar mb-1">
                        <div class="remaining-bar-fill @GetBarClass(spool.RemainingPercent)"
                             style="width: @((int)Math.Min(spool.RemainingPercent, 100))%"></div>
                    </div>
                    <small class="text-muted d-block mb-2">@spool.RemainingWeightGrams g – @spool.RemainingPercent%</small>

                    @if (spool.OwnerName != null)
                    {
                        <div class="mb-1"><span class="badge text-bg-light border"><i class="bi bi-person me-1"></i>@spool.OwnerName</span></div>
                    }
                    @if (spool.DryerId != null && spool.DriedAt == null)
                    {
                        <small class="text-muted me-2"><i class="bi bi-thermometer-half me-1 text-warning"></i>@spool.DryerName</small>
                    }
                    @if (spool.DryerId != null && spool.DriedAt != null)
                    {
                        var (elapsed, total, done) = GetDryingState(spool);
                        var pct = total > 0 ? Math.Min(elapsed / total * 100, 100) : 100;
                        <div class="@(done ? "drying-done" : "")">
                            <small class="text-muted">
                                <i class="bi bi-thermometer-half me-1"></i>
                                @spool.DryerName –
                                @if (done)
                                {
                                    <span class="text-success fw-semibold">@L["spool.drying.done"]</span>
                                }
                                else
                                {
                                    <span>@elapsed.ToString("F1")h / @total h</span>
                                }
                            </small>
                            <div class="drying-bar">
                                <div class="drying-bar-fill @(done ? "done" : "")" style="width:@((int)pct)%"></div>
                            </div>
                        </div>
                    }
                    @if (spool.PrinterName != null)
                    {
                        <small class="text-muted"><i class="bi bi-printer me-1"></i>@spool.PrinterName</small>
                    }
                    @if (spool.StorageLocationName != null)
                    {
                        <small class="text-muted ms-2"><i class="bi bi-box me-1"></i>@spool.StorageLocationName</small>
                    }

                    @if (_nfcTarget?.Id == spool.Id)
                    {
                        <div class="mt-2">
                            @if (_nfcWriting)
                            {
                                <div class="d-flex align-items-center gap-2 text-muted small">
                                    <span class="spinner-border spinner-border-sm"></span>
                                    <span>@L["tag.nfc.scanning"]</span>
                                </div>
                            }
                            else if (_nfcMessage != null)
                            {
                                <div class="alert @(_nfcSuccess ? "alert-success" : "alert-danger") py-1 mb-0 small">
                                    @_nfcMessage
                                </div>
                            }
                        </div>
                    }

                    @if (_jsonTarget == spool.Id && _jsonPayload != null)
                    {
                        <div class="position-relative mt-2">
                            <pre class="small bg-body-secondary text-body border rounded p-2 pe-5 mb-0" style="font-size:0.7rem;word-break:break-all;white-space:pre-wrap;">@_jsonPayload</pre>
                            <button class="btn btn-sm btn-outline-secondary position-absolute top-0 end-0 m-1" @onclick="CopyJsonAsync" title="@L["common.copy"]">
                                <i class="bi @(_jsonCopied ? "bi-check-lg text-success" : "bi-clipboard")"></i>
                            </button>
                        </div>
                    }

                    <div class="mt-2 d-flex gap-1">
                        <a href="/spools/@spool.Id" class="btn btn-sm btn-outline-primary flex-fill">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a href="/spools/@spool.Id/edit" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        @if (_nfcAvailable && spool.ConsumedAt == null)
                        {
                            <button class="btn btn-sm btn-outline-success" title="@L["spool.find.title"]"
                                    @onclick="() => FindSpoolAsync(spool)">
                                <i class="bi bi-search"></i>
                            </button>
                        }
                        @if (_nfcAvailable && spool.ConsumedAt == null)
                        {
                            <button class="btn btn-sm btn-outline-info" title="@L["spool.nfc.write.quick"]"
                                    @onclick="() => WriteNfcAsync(spool)"
                                    disabled="@(_nfcWriting && _nfcTarget?.Id == spool.Id)">
                                <i class="bi bi-broadcast"></i>
                            </button>
                        }
                        <button class="btn btn-sm btn-outline-secondary" title="@L["tag.download.bin"]"
                                @onclick="@(() => Tags.DownloadSpoolBinAsync(spool.Id))">
                            <i class="bi bi-download"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" title="@L["tag.show.json"]"
                                @onclick="@(() => ShowSpoolJsonAsync(spool.Id))">
                            <i class="bi bi-code"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" title="@L["common.copy"]" @onclick="() => CopyAsync(spool)">
                            <i class="bi bi-copy"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(spool)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (_deleteTarget != null)
{
    <div class="modal-backdrop-custom" @onclick="() => _deleteTarget = null">
        <div class="modal-box" @onclick:stopPropagation>
            <h5>@L["spool.delete"]</h5>
            <p>@L["spool.delete.confirm"]</p>
            <p><strong>@_deleteTarget.MaterialBrand @_deleteTarget.MaterialType</strong></p>
            <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-secondary" @onclick="() => _deleteTarget = null">@L["common.cancel"]</button>
                <button class="btn btn-danger" @onclick="DeleteAsync">@L["common.delete"]</button>
            </div>
        </div>
    </div>
}

@if (_findTarget != null)
{
    <FindSpoolModal @ref="_findModal" Spool="_findTarget" />
}

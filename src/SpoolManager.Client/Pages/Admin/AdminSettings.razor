@page "/admin/settings"

<PageTitle>@L["admin.settings.title"] – @L["app.name"]</PageTitle>

@if (Auth.CurrentUser?.IsPlatformAdmin != true)
{
    <AdminAccessDenied />
}
else
{
    <div class="page-header">
        <div>
            <h1>@L["admin.settings.title"]</h1>
            <p class="page-subtitle">@L["admin.settings.subtitle"]</p>
        </div>
    </div>

    <div class="as-layout">
        <nav class="as-nav" aria-label="@L["admin.settings.sections"]">
            @foreach (var (id, icon, key) in Sections)
            {
                <a class="sh-nav-link" href="/admin/settings#@id" @onclick="() => ScrollToAsync(id)" @onclick:preventDefault>
                    <i class="bi @icon" aria-hidden="true"></i>@L[key]
                </a>
            }
        </nav>

        <div class="as-sections">
            @* General *@
            <section id="general" class="sh-card as-section" aria-labelledby="as-general">
                <h2 id="as-general" class="sh-card-title">@L["admin.settings.general.title"]</h2>
                <p class="sh-card-sub mb-3">@L["admin.settings.general.subtitle"]</p>
                <div class="as-row">
                    <div class="flex-grow-1">
                        <label class="fw-semibold d-block" for="landingEnabled">@L["admin.settings.general.landing.label"]</label>
                        <div class="text-muted small" id="landingHint">@L["admin.settings.general.landing.hint"]</div>
                    </div>
                    <div class="form-check form-switch mb-0 as-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="landingEnabled" aria-describedby="landingHint"
                               checked="@_landingEnabled" @onchange="OnLandingChanged" disabled="@_landingSaving" />
                    </div>
                </div>
                @if (_landingMessage != null)
                {
                    <p class="as-feedback @(_landingOk ? "as-ok" : "as-bad") mb-0 mt-2" role="status">
                        <i class="bi @(_landingOk ? "bi-check-circle" : "bi-exclamation-circle")" aria-hidden="true"></i>@_landingMessage
                    </p>
                }
            </section>

            @* Branding *@
            <section id="branding" class="sh-card as-section" aria-labelledby="as-branding">
                <h2 id="as-branding" class="sh-card-title">@L["admin.settings.branding.title"]</h2>
                <p class="sh-card-sub mb-3">@L["admin.settings.branding.subtitle"]</p>
                @if (_brandingMessage != null)
                {
                    <div class="alert @(_brandingOk ? "alert-success" : "alert-danger") d-flex align-items-center gap-2 py-2" role="status">
                        <i class="bi @(_brandingOk ? "bi-check-circle" : "bi-exclamation-circle")" aria-hidden="true"></i>
                        <span class="flex-grow-1">@_brandingMessage</span>
                        <button type="button" class="btn-close" aria-label="@L["common.close"]" @onclick="() => _brandingMessage = null"></button>
                    </div>
                }
                <div class="as-brand-grid">
                    <div class="as-brand">
                        <div class="as-brand-title">@L["admin.settings.branding.logo"]</div>
                        <div class="as-brand-preview as-light">
                            @if (!string.IsNullOrEmpty(Branding.LogoDataUrl))
                            {
                                <img src="@Branding.LogoDataUrl" alt="@L["admin.settings.branding.logo"]" />
                            }
                            else
                            {
                                <span class="as-brand-empty">@L["admin.settings.branding.none"]</span>
                            }
                        </div>
                        <div class="form-text mt-0">@L["admin.settings.branding.logo.hint"]</div>
                        <div class="as-brand-actions">
                            <label class="btn btn-outline-secondary btn-sm as-file @(_brandingSaving ? "disabled" : "")">
                                <i class="bi bi-upload" aria-hidden="true"></i>@(string.IsNullOrEmpty(Branding.LogoDataUrl) ? L["admin.settings.branding.upload"] : L["admin.settings.branding.replace"])
                                <InputFile OnChange="OnLogoSelected" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml" disabled="@_brandingSaving" />
                            </label>
                            @if (!string.IsNullOrEmpty(Branding.LogoDataUrl))
                            {
                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick='() => AskDelete("logo")' disabled="@_brandingSaving">
                                    <i class="bi bi-trash" aria-hidden="true"></i>@L["common.delete"]
                                </button>
                            }
                        </div>
                    </div>

                    <div class="as-brand">
                        <div class="as-brand-title">@L["admin.settings.branding.logo.dark"]</div>
                        <div class="as-brand-preview as-dark">
                            @if (!string.IsNullOrEmpty(Branding.LogoDarkDataUrl))
                            {
                                <img src="@Branding.LogoDarkDataUrl" alt="@L["admin.settings.branding.logo.dark"]" />
                            }
                            else if (!string.IsNullOrEmpty(Branding.LogoDataUrl))
                            {
                                <img src="@Branding.LogoDataUrl" alt="@L["admin.settings.branding.logo.dark"]" />
                            }
                            else
                            {
                                <span class="as-brand-empty">@L["admin.settings.branding.none"]</span>
                            }
                        </div>
                        <div class="form-text mt-0">@L["admin.settings.branding.logo.dark.hint"]</div>
                        <div class="as-brand-actions">
                            <label class="btn btn-outline-secondary btn-sm as-file @(_brandingSaving ? "disabled" : "")">
                                <i class="bi bi-upload" aria-hidden="true"></i>@(string.IsNullOrEmpty(Branding.LogoDarkDataUrl) ? L["admin.settings.branding.upload"] : L["admin.settings.branding.replace"])
                                <InputFile OnChange="OnLogoDarkSelected" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml" disabled="@_brandingSaving" />
                            </label>
                            @if (!string.IsNullOrEmpty(Branding.LogoDarkDataUrl))
                            {
                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick='() => AskDelete("logodark")' disabled="@_brandingSaving">
                                    <i class="bi bi-trash" aria-hidden="true"></i>@L["common.delete"]
                                </button>
                            }
                        </div>
                    </div>

                    <div class="as-brand">
                        <div class="as-brand-title">@L["admin.settings.branding.favicon"]</div>
                        <div class="as-brand-preview">
                            @if (!string.IsNullOrEmpty(Branding.FaviconDataUrl))
                            {
                                <img src="@Branding.FaviconDataUrl" alt="@L["admin.settings.branding.favicon"]" class="as-favicon" />
                            }
                            else
                            {
                                <span class="as-brand-empty">@L["admin.settings.branding.favicon.default"]</span>
                            }
                        </div>
                        <div class="form-text mt-0">@L["admin.settings.branding.favicon.hint"]</div>
                        <div class="as-brand-actions">
                            <label class="btn btn-outline-secondary btn-sm as-file @(_brandingSaving ? "disabled" : "")">
                                <i class="bi bi-upload" aria-hidden="true"></i>@(string.IsNullOrEmpty(Branding.FaviconDataUrl) ? L["admin.settings.branding.upload"] : L["admin.settings.branding.replace"])
                                <InputFile OnChange="OnFaviconSelected" accept="image/png,image/jpeg,image/x-icon" disabled="@_brandingSaving" />
                            </label>
                            @if (!string.IsNullOrEmpty(Branding.FaviconDataUrl))
                            {
                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick='() => AskDelete("favicon")' disabled="@_brandingSaving">
                                    <i class="bi bi-trash" aria-hidden="true"></i>@L["common.delete"]
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </section>

            @* Email *@
            <section id="email" class="sh-card as-section" aria-labelledby="as-email">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
                    <div>
                        <h2 id="as-email" class="sh-card-title">@L["admin.settings.smtp.title"]</h2>
                        <p class="sh-card-sub mb-3">@L["admin.settings.smtp.subtitle"]</p>
                    </div>
                    @if (_smtp != null)
                    {
                        <span class="sh-chip @(_smtpSavedEnabled ? "sh-chip-ok" : "sh-chip-warn")">
                            <i class="bi @(_smtpSavedEnabled ? "bi-check-circle" : "bi-pause-circle")" aria-hidden="true"></i>
                            @(_smtpSavedEnabled ? L["admin.settings.smtp.status.on"] : L["admin.settings.smtp.status.off"])
                        </span>
                    }
                </div>

                @if (_smtpLoading)
                {
                    <div class="placeholder-glow" role="status"><span class="placeholder col-12 mb-2"></span><span class="placeholder col-8"></span><span class="visually-hidden">@L["common.loading"]</span></div>
                }
                else if (_smtp != null)
                {
                    @if (_smtpMessage != null)
                    {
                        <div class="alert @(_smtpOk ? "alert-success" : "alert-danger") d-flex align-items-center gap-2 py-2" role="status">
                            <i class="bi @(_smtpOk ? "bi-check-circle" : "bi-exclamation-circle")" aria-hidden="true"></i>
                            <span class="flex-grow-1">@_smtpMessage</span>
                            <button type="button" class="btn-close" aria-label="@L["common.close"]" @onclick="() => _smtpMessage = null"></button>
                        </div>
                    }

                    <form @onsubmit="SaveSmtpAsync" @onsubmit:preventDefault>
                        <div class="row g-3">
                            <div class="col-12 col-md-8">
                                <label class="form-label" for="smtpHost">@L["admin.settings.smtp.host"]</label>
                                <input id="smtpHost" class="form-control" @bind="_smtp.Host" placeholder="smtp.example.com" autocomplete="off" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label" for="smtpPort">@L["admin.settings.smtp.port"]</label>
                                <input id="smtpPort" class="form-control" type="number" min="1" max="65535" inputmode="numeric" @bind="_smtp.Port" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="smtpUser">@L["admin.settings.smtp.username"]</label>
                                <input id="smtpUser" class="form-control" @bind="_smtp.Username" autocomplete="off" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="smtpPassword">@L["admin.settings.smtp.password"]</label>
                                <PasswordField Id="smtpPassword" @bind-Value="_smtp.Password" Autocomplete="new-password" Required="false" DescribedBy="smtpPasswordHelp" />
                                <div id="smtpPasswordHelp" class="form-text">@L["admin.settings.smtp.password.hint"]</div>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="smtpFrom">@L["admin.settings.smtp.from.email"]</label>
                                <input id="smtpFrom" class="form-control" type="email" @bind="_smtp.FromEmail" placeholder="noreply@example.com" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="smtpFromName">@L["admin.settings.smtp.from.name"]</label>
                                <input id="smtpFromName" class="form-control" @bind="_smtp.FromName" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="smtpBaseUrl">@L["admin.settings.smtp.base.url"]</label>
                                <input id="smtpBaseUrl" class="form-control" type="url" @bind="_smtp.BaseUrl" placeholder="https://spoolhero.example.com" aria-describedby="smtpBaseUrlHelp" />
                                <div id="smtpBaseUrlHelp" class="form-text">@L["admin.settings.smtp.base.url.hint"]</div>
                            </div>
                            <div class="col-12">
                                <fieldset class="as-switches">
                                    <legend class="form-label">@L["admin.settings.smtp.security"]</legend>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" id="useSsl" @bind="_smtp.UseSsl" />
                                        <label class="form-check-label" for="useSsl">@L["admin.settings.smtp.ssl"]</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" id="useStartTls" @bind="_smtp.UseStartTls" />
                                        <label class="form-check-label" for="useStartTls">@L["admin.settings.smtp.starttls"]</label>
                                    </div>
                                </fieldset>
                            </div>
                            <div class="col-12">
                                <div class="as-row as-enable">
                                    <div class="flex-grow-1">
                                        <label class="fw-semibold d-block" for="smtpEnabled">@L["admin.settings.smtp.enabled"]</label>
                                        <div class="text-muted small" id="smtpEnabledHint">@L["admin.settings.smtp.enabled.hint"]</div>
                                    </div>
                                    <div class="form-check form-switch mb-0 as-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" id="smtpEnabled" aria-describedby="smtpEnabledHint" @bind="_smtp.IsEnabled" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary" disabled="@_smtpSaving" aria-busy="@(_smtpSaving ? "true" : "false")">
                                @if (_smtpSaving)
                                {
                                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                                }
                                @L["admin.settings.smtp.save"]
                            </button>
                        </div>
                    </form>

                    <div class="as-test">
                        <h3 class="h6 mb-1">@L["admin.settings.smtp.test.title"]</h3>
                        <p class="small text-muted mb-2">@L["admin.settings.smtp.test.hint"]</p>
                        <form class="as-test-row" @onsubmit="TestSmtpAsync" @onsubmit:preventDefault>
                            <label for="smtpTestEmail" class="visually-hidden">@L["admin.settings.smtp.test.email"]</label>
                            <input id="smtpTestEmail" class="form-control" type="email" @bind="_testEmail" placeholder="@L["admin.settings.smtp.test.email"]" />
                            <button type="submit" class="btn btn-outline-secondary" disabled="@_smtpTesting" aria-busy="@(_smtpTesting ? "true" : "false")">
                                @if (_smtpTesting)
                                {
                                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <i class="bi bi-send" aria-hidden="true"></i>
                                }
                                @L["admin.settings.smtp.test"]
                            </button>
                        </form>
                    </div>
                }
            </section>

            @* Material database *@
            <section id="ofd" class="sh-card as-section" aria-labelledby="as-ofd">
                <h2 id="as-ofd" class="sh-card-title">@L["admin.ofd.sync"]</h2>
                <p class="sh-card-sub mb-3">@L["admin.settings.ofd.hint"]</p>
                @if (_ofdMessage != null)
                {
                    <p class="as-feedback @(_ofdOk ? "as-ok" : "as-bad")" role="status">
                        <i class="bi @(_ofdOk ? "bi-check-circle" : "bi-exclamation-circle")" aria-hidden="true"></i>@_ofdMessage
                    </p>
                }
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="SyncOfdAsync" disabled="@_ofdSyncing" aria-busy="@(_ofdSyncing ? "true" : "false")">
                        @if (_ofdSyncing)
                        {
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>@L["admin.ofd.sync.running"]
                        }
                        else
                        {
                            <i class="bi bi-cloud-download" aria-hidden="true"></i>@L["admin.ofd.sync.button"]
                        }
                    </button>
                    <a href="/admin/materials" class="btn btn-link">@L["admin.settings.ofd.open.materials"]</a>
                </div>
            </section>

            @* Legal *@
            <section id="legal" class="sh-card as-section" aria-labelledby="as-legal">
                <h2 id="as-legal" class="sh-card-title">@L["admin.settings.legal.title"]</h2>
                <p class="sh-card-sub mb-3">@L["admin.settings.legal.hint"]</p>

                @if (_legalLoading)
                {
                    <div class="placeholder-glow" role="status"><span class="placeholder col-12 mb-2"></span><span class="placeholder col-8"></span><span class="visually-hidden">@L["common.loading"]</span></div>
                }
                else if (_legal != null)
                {
                    @if (_legalMessage != null)
                    {
                        <div class="alert @(_legalOk ? "alert-success" : "alert-danger") d-flex align-items-center gap-2 py-2" role="status">
                            <i class="bi @(_legalOk ? "bi-check-circle" : "bi-exclamation-circle")" aria-hidden="true"></i>
                            <span class="flex-grow-1">@_legalMessage</span>
                            <button type="button" class="btn-close" aria-label="@L["common.close"]" @onclick="() => _legalMessage = null"></button>
                        </div>
                    }

                    <div class="as-legal-bar">
                        <div class="sh-segmented" role="group" aria-label="@L["admin.settings.legal.document"]">
                            @foreach (var (doc, key) in LegalDocs)
                            {
                                <button type="button" aria-pressed="@(_legalDoc == doc ? "true" : "false")" @onclick="() => _legalDoc = doc">
                                    @L[key]
                                    @if (string.IsNullOrWhiteSpace(GetLegal(doc, "de")) && string.IsNullOrWhiteSpace(GetLegal(doc, "en")))
                                    {
                                        <span class="as-dot" title="@L["admin.settings.legal.missing"]"><span class="visually-hidden">@L["admin.settings.legal.missing"]</span></span>
                                    }
                                </button>
                            }
                        </div>
                        <div class="sh-segmented" role="group" aria-label="@L["nav.language"]">
                            <button type="button" aria-pressed="@(_legalLang == "de" ? "true" : "false")" @onclick='() => _legalLang = "de"' lang="de">Deutsch</button>
                            <button type="button" aria-pressed="@(_legalLang == "en" ? "true" : "false")" @onclick='() => _legalLang = "en"' lang="en">English</button>
                        </div>
                        <div class="sh-segmented ms-lg-auto" role="group" aria-label="@L["admin.settings.legal.mode"]">
                            <button type="button" aria-pressed="@(!_legalPreview ? "true" : "false")" @onclick="() => _legalPreview = false"><i class="bi bi-code-slash" aria-hidden="true"></i>@L["admin.settings.legal.edit"]</button>
                            <button type="button" aria-pressed="@(_legalPreview ? "true" : "false")" @onclick="() => _legalPreview = true"><i class="bi bi-eye" aria-hidden="true"></i>@L["admin.settings.legal.preview"]</button>
                        </div>
                    </div>

                    @if (_legalPreview)
                    {
                        <div class="as-legal-preview">
                            @if (string.IsNullOrWhiteSpace(CurrentLegal))
                            {
                                <p class="text-muted mb-0">@L["legal.not.configured"]</p>
                            }
                            else
                            {
                                <Prose Html="@CurrentLegal" />
                            }
                        </div>
                    }
                    else
                    {
                        <label class="visually-hidden" for="legalText">@L[LegalDocs.First(d => d.Doc == _legalDoc).Key] (@_legalLang.ToUpperInvariant())</label>
                        <textarea id="legalText" class="form-control font-monospace as-legal-text" rows="16" value="@CurrentLegal" @oninput="OnLegalChanged"
                                  placeholder="@L["admin.settings.legal.empty.hint"]" spellcheck="false"></textarea>
                    }

                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                        <button type="button" class="btn btn-primary" @onclick="SaveLegalAsync" disabled="@_legalSaving" aria-busy="@(_legalSaving ? "true" : "false")">
                            @if (_legalSaving)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg" aria-hidden="true"></i>
                            }
                            @L["admin.settings.legal.save"]
                        </button>
                        <a class="btn btn-link" href="/@_legalDoc" target="_blank" rel="noopener">@L["admin.settings.legal.view"] <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                    </div>
                }
            </section>
        </div>
    </div>

    @if (_confirmDelete != null)
    {
        <div class="modal-backdrop-custom" @onclick="() => _confirmDelete = null">
            <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="asDeleteTitle" @onclick:stopPropagation>
                <h2 id="asDeleteTitle" class="h5">@L["admin.settings.branding.delete.title"]</h2>
                <p>@L["admin.settings.branding.delete.text"]</p>
                <div class="d-flex gap-2 justify-content-end flex-wrap">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _confirmDelete = null">@L["common.cancel"]</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync"><i class="bi bi-trash" aria-hidden="true"></i>@L["common.delete"]</button>
                </div>
            </div>
        </div>
    }
}

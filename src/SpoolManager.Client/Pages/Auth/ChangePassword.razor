@page "/settings/password"

<SettingsShell Title="@L["auth.change.password"]" Subtitle="@L["settings.password.subtitle"]">
    <section class="settings-section" aria-labelledby="pw-title">
        <h2 id="pw-title">@L["settings.password.section"]</h2>
        <p class="settings-section-text">@L["settings.password.text"]</p>

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_success ? "alert-success" : "alert-danger") py-2" role="@(_success ? "status" : "alert")">@_message</div>
        }

        <form @onsubmit="SubmitAsync" @onsubmit:preventDefault class="pw-form">
            <div class="mb-3">
                <label class="form-label" for="pw-current">@L["auth.current.password"]</label>
                <input id="pw-current" type="password" class="form-control" @bind="_model.CurrentPassword" @bind:event="oninput"
                       autocomplete="current-password" required />
            </div>
            <div class="mb-3">
                <label class="form-label" for="pw-new">@L["auth.new.password"]</label>
                <input id="pw-new" type="password" class="form-control @(NewTooShort ? "is-invalid" : "")" @bind="_model.NewPassword" @bind:event="oninput"
                       autocomplete="new-password" minlength="8" required aria-describedby="pw-new-hint" />
                <div id="pw-new-hint" class="@(NewTooShort ? "invalid-feedback d-block" : "form-text")">@L["settings.password.rule"]</div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="pw-confirm">@L["auth.new.password.confirm"]</label>
                <input id="pw-confirm" type="password" class="form-control @(Mismatch ? "is-invalid" : "")" @bind="_confirmPassword" @bind:event="oninput"
                       autocomplete="new-password" required aria-describedby="pw-confirm-hint" />
                @if (Mismatch)
                {
                    <div id="pw-confirm-hint" class="invalid-feedback d-block">@L["auth.password.mismatch"]</div>
                }
            </div>
            <div class="settings-actions">
                <button type="submit" class="btn btn-primary" disabled="@(!CanSubmit)">
                    @if (_loading) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                    @L["auth.change.password"]
                </button>
            </div>
        </form>
    </section>

    <section class="settings-section" aria-labelledby="pw-forgot">
        <h2 id="pw-forgot">@L["settings.password.forgot.title"]</h2>
        <p class="settings-section-text">@L["settings.password.forgot.text"]</p>
        <a class="btn btn-outline-secondary" href="/forgot-password">@L["settings.password.forgot.action"]</a>
    </section>
</SettingsShell>

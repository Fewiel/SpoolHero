@page "/reset-password"

<PageTitle>@L["auth.reset.password"] – @L["app.name"]</PageTitle>

<PublicShell Variant="auth" BypassWhenAuthenticated="true">
    <div class="sh-auth-card">
        @if (_success)
        {
            <div class="sh-auth-head mb-3" role="status">
                <span class="sh-auth-icon sh-ok" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                <h1>@L["auth.reset.done.title"]</h1>
                <p>@L["auth.reset.success"]</p>
            </div>
            <a href="/login" class="btn btn-primary btn-lg w-100">@L["auth.login.submit"]</a>
        }
        else if (string.IsNullOrEmpty(_token) || _linkBroken)
        {
            <div class="sh-auth-head mb-3">
                <span class="sh-auth-icon sh-danger" aria-hidden="true"><i class="bi bi-link-45deg"></i></span>
                <h1>@L["auth.reset.invalid.title"]</h1>
                <p role="alert">@(_linkExpired ? L["auth.reset.expired"] : L["auth.reset.invalid"])</p>
            </div>
            <p class="text-muted small text-center">@L["auth.reset.invalid.hint"]</p>
            <a href="/forgot-password" class="btn btn-primary btn-lg w-100">@L["auth.reset.request.new"]</a>
            <p class="sh-auth-alt mb-0"><a href="/login">@L["auth.back.to.login"]</a></p>
        }
        else
        {
            <div class="sh-auth-head">
                <span class="sh-auth-icon" aria-hidden="true"><i class="bi bi-shield-lock"></i></span>
                <h1>@L["auth.reset.password"]</h1>
                <p>@L["auth.reset.subtitle"]</p>
            </div>

            @if (_error != null)
            {
                <div class="alert alert-danger d-flex gap-2" role="alert">
                    <i class="bi bi-exclamation-circle mt-1" aria-hidden="true"></i><span>@_error</span>
                </div>
            }

            <form @onsubmit="ResetAsync" @onsubmit:preventDefault novalidate>
                <div class="mb-3">
                    <label class="form-label" for="resetPassword">@L["auth.new.password"]</label>
                    <PasswordField Id="resetPassword" @bind-Value="_password" Autocomplete="new-password"
                                   Invalid="_passwordError != null" DescribedBy="resetPasswordHelp">
                        @if (_passwordError != null)
                        {
                            <div class="invalid-feedback">@_passwordError</div>
                        }
                    </PasswordField>
                    <div id="resetPasswordHelp" class="form-text">@L["auth.password.min"]</div>
                </div>
                <div class="mb-4">
                    <label class="form-label" for="resetPasswordConfirm">@L["auth.confirm.password"]</label>
                    <PasswordField Id="resetPasswordConfirm" @bind-Value="_confirmPassword" Autocomplete="new-password"
                                   Invalid="_confirmError != null">
                        @if (_confirmError != null)
                        {
                            <div class="invalid-feedback">@_confirmError</div>
                        }
                    </PasswordField>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@_loading" aria-busy="@(_loading ? "true" : "false")">
                    @if (_loading)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    }
                    @L["auth.reset.submit"]
                </button>
            </form>
        }
    </div>
</PublicShell>

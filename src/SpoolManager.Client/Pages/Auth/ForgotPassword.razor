@page "/forgot-password"

<PageTitle>@L["auth.forgot.title"] – @L["app.name"]</PageTitle>

<PublicShell Variant="auth" BypassWhenAuthenticated="true">
    <div class="sh-auth-card">
        @if (_sent)
        {
            <div class="sh-auth-head mb-3" role="status">
                <span class="sh-auth-icon sh-ok" aria-hidden="true"><i class="bi bi-envelope-check"></i></span>
                <h1>@L["auth.forgot.sent.title"]</h1>
                <p>@L["auth.forgot.success"]</p>
            </div>
            <p class="text-muted small text-center">@L["auth.forgot.sent.hint"]</p>
            <a href="/login" class="btn btn-primary btn-lg w-100">@L["auth.back.to.login"]</a>
            <p class="sh-auth-alt mb-0">
                <button type="button" class="btn btn-link p-0" @onclick="() => _sent = false">@L["auth.forgot.again"]</button>
            </p>
        }
        else
        {
            <div class="sh-auth-head">
                <span class="sh-auth-icon" aria-hidden="true"><i class="bi bi-key"></i></span>
                <h1>@L["auth.forgot.title"]</h1>
                <p>@L["auth.forgot.hint"]</p>
            </div>

            @if (_error != null)
            {
                <div class="alert alert-danger d-flex gap-2" role="alert">
                    <i class="bi bi-exclamation-circle mt-1" aria-hidden="true"></i><span>@_error</span>
                </div>
            }

            <form @onsubmit="SendAsync" @onsubmit:preventDefault novalidate>
                <div class="mb-3">
                    <label class="form-label" for="forgotEmail">@L["auth.email"]</label>
                    <input id="forgotEmail" class="form-control @(_emailInvalid ? "is-invalid" : "")" type="email" @bind="_email"
                           required autocomplete="email" inputmode="email" />
                    @if (_emailInvalid)
                    {
                        <div class="invalid-feedback">@L["auth.email.invalid"]</div>
                    }
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@_loading" aria-busy="@(_loading ? "true" : "false")">
                    @if (_loading)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    }
                    @L["auth.forgot.submit"]
                </button>
            </form>

            <p class="sh-auth-alt mb-0">
                <a href="/login" class="fw-semibold"><i class="bi bi-arrow-left" aria-hidden="true"></i> @L["auth.back.to.login"]</a>
            </p>
        }
    </div>
</PublicShell>

@page "/login"

<PageTitle>@L["app.name"] – @L["landing.tagline.short"]</PageTitle>

@if (!Branding.LandingPageEnabled)
{
    <PublicShell Variant="auth">
        <div class="sh-auth-card">
            <div class="sh-auth-head">
                <span class="sh-auth-icon" aria-hidden="true"><i class="bi bi-person"></i></span>
                <h1>@L["auth.login.title"]</h1>
                <p>@L["auth.login.subtitle"]</p>
            </div>
            <LoginForm IdPrefix="login" />
        </div>
    </PublicShell>
}
else
{
    <PublicShell Variant="landing">
        <HeaderActions>
            <a href="#login-form" class="btn btn-outline-secondary d-none d-sm-inline-flex">@L["auth.login"]</a>
            <a href="/register" class="btn btn-primary">@L["auth.register.cta"]</a>
        </HeaderActions>
        <ChildContent>
            <section class="lp-hero" aria-labelledby="lp-title">
                <div class="lp-wrap lp-hero-grid">
                    <div class="lp-hero-text">
                        <span class="sh-chip sh-chip-ok"><i class="bi bi-gift" aria-hidden="true"></i>@L["landing.free.badge"]</span>
                        <h1 id="lp-title">@L["landing.hero.headline"]</h1>
                        <p class="lp-lead">@L["landing.hero.subline"]</p>
                        <div class="lp-cta">
                            <a href="/register" class="btn btn-primary btn-lg">
                                <i class="bi bi-person-plus" aria-hidden="true"></i>@L["landing.cta.register"]
                            </a>
                            <a href="#login-form" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>@L["landing.cta.login"]
                            </a>
                        </div>
                        <ul class="lp-points">
                            <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i>@L["landing.point.rings"]</li>
                            <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i>@L["landing.point.scan"]</li>
                            <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i>@L["landing.point.team"]</li>
                        </ul>
                    </div>

                    <div class="lp-login" id="login-form">
                        <div class="sh-auth-card">
                            <h2 class="lp-login-title">@L["auth.login.title"]</h2>
                            <p class="text-muted mb-4">@L["auth.login.subtitle"]</p>
                            <LoginForm IdPrefix="landingLogin" />
                        </div>
                    </div>
                </div>

                <div class="lp-wrap">
                    <figure class="lp-preview">
                        <figcaption class="visually-hidden">@L["landing.preview.description"]</figcaption>
                        <div class="lp-preview-head" aria-hidden="true">
                            <div>
                                <div class="lp-preview-title">@L["landing.preview.title"]</div>
                                <div class="lp-preview-sub">@L["landing.preview.subtitle"]</div>
                            </div>
                            <span class="sh-chip sh-chip-sm"><i class="bi bi-record-circle" aria-hidden="true"></i>6 @L["nav.spools"]</span>
                        </div>
                        <div class="lp-preview-body" aria-hidden="true">
                            <div class="lp-shelf">
                                @foreach (var s in PreviewSpools)
                                {
                                    <div class="lp-spool @(s.Percent < 20 ? "lp-low" : "")">
                                        <SpoolRing ColorHex="@s.Hex" Percent="s.Percent" Size="72">@(s.Percent) %</SpoolRing>
                                        <div class="lp-spool-name">@s.Type</div>
                                        <div class="lp-spool-color">@L[s.ColorKey]</div>
                                    </div>
                                }
                            </div>
                            <div class="lp-attention">
                                <SpoolRing ColorHex="FF6A13" Percent="12" Size="48" />
                                <div class="lp-attention-text">
                                    <span class="sh-chip sh-chip-warn sh-chip-sm">@L["landing.preview.low"]</span>
                                    <strong>@L["landing.preview.attention"]</strong>
                                    <span class="text-muted small">@L["landing.preview.attention.hint"]</span>
                                </div>
                                <span class="btn btn-sm btn-outline-secondary lp-fake-btn"><i class="bi bi-cart" aria-hidden="true"></i>@L["landing.preview.reorder"]</span>
                            </div>
                        </div>
                    </figure>
                </div>
            </section>

            <section class="lp-section" aria-labelledby="lp-steps">
                <div class="lp-wrap">
                    <div class="lp-section-head">
                        <h2 id="lp-steps">@L["landing.steps.title"]</h2>
                        <p>@L["landing.steps.subtitle"]</p>
                    </div>
                    <ol class="lp-steps">
                        <li>
                            <span class="lp-step-no" aria-hidden="true">1</span>
                            <h3>@L["landing.step1.title"]</h3>
                            <p>@L["landing.step1.desc"]</p>
                        </li>
                        <li>
                            <span class="lp-step-no" aria-hidden="true">2</span>
                            <h3>@L["landing.step2.title"]</h3>
                            <p>@L["landing.step2.desc"]</p>
                        </li>
                        <li>
                            <span class="lp-step-no" aria-hidden="true">3</span>
                            <h3>@L["landing.step3.title"]</h3>
                            <p>@L["landing.step3.desc"]</p>
                        </li>
                    </ol>
                </div>
            </section>

            <section class="lp-section lp-section-alt" aria-labelledby="lp-features">
                <div class="lp-wrap">
                    <div class="lp-section-head">
                        <h2 id="lp-features">@L["landing.features.title"]</h2>
                        <p>@L["landing.features.subtitle"]</p>
                    </div>
                    <div class="lp-features">
                        @foreach (var f in Features)
                        {
                            <article class="lp-feature">
                                <span class="lp-feature-icon" aria-hidden="true"><i class="bi @f.Icon"></i></span>
                                <h3>@L[f.Key + ".title"]</h3>
                                <p>@L[f.Key + ".desc"]</p>
                            </article>
                        }
                    </div>
                    <p class="lp-note">
                        <i class="bi bi-android2" aria-hidden="true"></i>@L["landing.nfc.android.note"]
                    </p>
                </div>
            </section>

            <section class="lp-section" aria-labelledby="lp-open">
                <div class="lp-wrap">
                    <h2 id="lp-open" class="visually-hidden">@L["landing.open.title"]</h2>
                    <div class="lp-links">
                        <article class="sh-card lp-link-card">
                            <span class="lp-feature-icon" aria-hidden="true"><i class="bi bi-broadcast"></i></span>
                            <h3>@L["landing.openspool.title"]</h3>
                            <p>@L["landing.openspool.desc"]</p>
                            <a href="https://github.com/Bambu-Research-Group/RFID-Tag-Guide" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary">
                                <i class="bi bi-github" aria-hidden="true"></i>@L["landing.openspool.github"]
                            </a>
                        </article>
                        <article class="sh-card lp-link-card">
                            <span class="lp-feature-icon" aria-hidden="true"><i class="bi bi-tags"></i></span>
                            <h3>@L["landing.ntag.title"]</h3>
                            <p>@L["landing.ntag.desc"]</p>
                            <a href="https://amzn.to/46W8bpt" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary">
                                <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>@L["landing.ntag.link"]
                            </a>
                        </article>
                        <article class="sh-card lp-link-card">
                            <span class="lp-feature-icon" aria-hidden="true"><i class="bi bi-code-slash"></i></span>
                            <h3>@L["landing.opensource.title"]</h3>
                            <p>@L["landing.opensource.desc"]</p>
                            <a href="https://github.com/Fewiel/SpoolHero" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary">
                                <i class="bi bi-github" aria-hidden="true"></i>@L["landing.opensource.github"]
                            </a>
                        </article>
                    </div>
                </div>
            </section>

            <section class="lp-section" aria-labelledby="lp-free">
                <div class="lp-wrap">
                    <div class="lp-free">
                        <span class="sh-auth-icon sh-ok" aria-hidden="true"><i class="bi bi-gift"></i></span>
                        <h2 id="lp-free">@L["landing.free.title"]</h2>
                        <p>@L["landing.free.desc"]</p>
                        <div class="lp-free-chips">
                            <span class="sh-chip sh-chip-ok"><i class="bi bi-heart" aria-hidden="true"></i>@L["landing.free.funded.donations"]</span>
                            <span class="sh-chip sh-chip-accent"><i class="bi bi-link-45deg" aria-hidden="true"></i>@L["landing.free.funded.affiliate"]</span>
                        </div>
                        <a href="/register" class="btn btn-primary btn-lg">
                            <i class="bi bi-person-plus" aria-hidden="true"></i>@L["landing.cta.register"]
                        </a>
                        <p class="lp-tos">
                            @L["landing.tos.desc"] <a href="/terms">@L["landing.tos.link"]</a>
                        </p>
                    </div>
                </div>
            </section>
        </ChildContent>
    </PublicShell>
}

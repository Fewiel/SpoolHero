@page "/materials/orca"

<PageTitle>@L["material.export.orca"] – @L["app.name"]</PageTitle>

<div class="page-header">
    <div>
        <h1>@L["material.export.orca"]</h1>
        <p class="page-subtitle">@L["material.orca.subtitle"]</p>
    </div>
    <div class="page-actions">
        <a href="/materials" class="btn btn-outline-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i>@L["material.form.back"]</a>
    </div>
</div>

<div class="orca-grid">
    <div class="orca-main">
        <section class="sh-card" aria-labelledby="orca-spools">
            <h2 class="sh-card-title" id="orca-spools">@L["material.export.orca.from.spools"]</h2>
            <p class="sh-card-sub mb-3">@L["material.orca.spools.hint"]</p>
            <SpoolMaterialQuickPick SelectedIds="SelectedIds" OnAdd="AddByIdAsync" OnRemove="Remove" />
        </section>

        <section class="sh-card" aria-labelledby="orca-other">
            <h2 class="sh-card-title" id="orca-other">@L["material.export.orca.select"]</h2>
            <p class="sh-card-sub mb-3">@L["material.orca.other.hint"]</p>
            <MaterialPicker Value="_pickerId" OnSelected="OnPicked" />
        </section>
    </div>

    <aside class="sh-card orca-side" aria-labelledby="orca-selected">
        <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
            <h2 class="sh-card-title mb-0" id="orca-selected">@L["material.orca.selected"]</h2>
            @if (_selectedMaterials.Count > 0)
            {
                <button type="button" class="btn btn-link btn-sm" @onclick="Clear">@L["common.clear"]</button>
            }
        </div>

        <SelectedMaterials Items="_selectedMaterials" OnRemove="Remove" EmptyText="@L["material.orca.none.selected"]"
                           WarnWhen="NeedsTemps" WarnText="@L["material.export.orca.warning.short"]" />

        @if (Warnings.Count > 0)
        {
            <div class="alert alert-warning mt-3 mb-0" role="alert">
                <div class="d-flex gap-2"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span>@L["material.orca.warning"]</span></div>
                <ul class="mb-0 mt-2 small orca-warn-list">
                    @foreach (var w in Warnings)
                    {
                        <li>
                            <span>@w.Brand @w.Type @(w.ColorName != null ? $"– {w.ColorName}" : "")</span>
                            @if (w.IsGlobal)
                            {
                                <a href="/materials/@w.Id/suggest">@L["material.action.suggest"]</a>
                            }
                            else
                            {
                                <a href="/materials/@w.Id/edit">@L["material.orca.fix"]</a>
                            }
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="orca-actions">
            <button type="button" class="btn btn-primary" @onclick="ExportSelectedAsync" disabled="@(_exporting || _selectedMaterials.Count == 0)">
                @if (_exporting) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                else { <i class="bi bi-download" aria-hidden="true"></i> }
                @L.Format("material.orca.download", _selectedMaterials.Count)
            </button>
            <p class="small text-muted mb-0">@L["material.orca.format"]</p>
        </div>

        @if (_orcaError != null)
        {
            <div class="alert alert-danger mt-3 mb-0 py-2" role="alert">@_orcaError</div>
        }
        @if (_orcaSuccess)
        {
            <div class="alert alert-success mt-3 mb-0 py-2" role="status">
                <i class="bi bi-check-circle" aria-hidden="true"></i> @L["material.export.orca.done"]
            </div>
        }

        <details class="orca-help">
            <summary>@L["material.orca.howto"]</summary>
            <p class="small text-muted mb-0 mt-2">@L["material.export.orca.hint"]</p>
        </details>

        <hr />
        <button type="button" class="btn btn-outline-secondary w-100" @onclick="ExportAllAsync" disabled="@_exporting">
            <i class="bi bi-collection" aria-hidden="true"></i>@L["material.export.orca.all"]
        </button>
        <p class="small text-muted mt-2 mb-0">@L["material.orca.all.hint"]</p>
    </aside>
</div>

@page "/materials/new"
@page "/materials/{Id:guid}/edit"
@page "/materials/{CloneId:guid}/clone"

<PageTitle>@Title – @L["app.name"]</PageTitle>

<div class="page-header">
    <div>
        <h1>@Title</h1>
        <p class="page-subtitle">@Subtitle</p>
    </div>
    <div class="page-actions">
        <a href="/materials" class="btn btn-outline-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i>@L["material.form.back"]</a>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">@L["common.loading"]</span></div></div>
}
else if (_notFound)
{
    <div class="sh-empty">
        <i class="bi bi-question-circle" aria-hidden="true"></i>
        <h2>@L["material.form.notfound.title"]</h2>
        <p>@L["material.form.notfound.text"]</p>
        <a class="btn btn-primary mt-2" href="/materials"><i class="bi bi-arrow-left" aria-hidden="true"></i>@L["material.form.back"]</a>
    </div>
}
else if (_readOnlyGlobal)
{
    <div class="sh-empty">
        <i class="bi bi-globe2" aria-hidden="true"></i>
        <h2>@L["material.form.global.title"]</h2>
        <p>@L["material.form.global.text"]</p>
        <div class="d-flex gap-2 flex-wrap justify-content-center mt-2">
            <a class="btn btn-primary" href="/materials/@Id/clone"><i class="bi bi-copy" aria-hidden="true"></i>@L["material.action.clone"]</a>
            <a class="btn btn-outline-secondary" href="/materials/@Id/suggest"><i class="bi bi-lightbulb" aria-hidden="true"></i>@L["material.action.suggest"]</a>
        </div>
    </div>
}
else
{
    <form class="mf-layout" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <div class="mf-main">
            @if (CloneId.HasValue)
            {
                <div class="alert alert-info d-flex gap-2 align-items-start">
                    <i class="bi bi-copy mt-1" aria-hidden="true"></i>
                    <span>@L["material.form.clone.hint"]</span>
                </div>
            }

            @* Identity *@
            <section class="sh-card mf-section" aria-labelledby="mf-identity">
                <h2 class="sh-card-title" id="mf-identity">@L["material.form.section.identity"]</h2>
                <p class="sh-card-sub mb-3">@L["material.form.section.identity.hint"]</p>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="mf-brand">@L["material.brand"] <span class="text-danger" aria-hidden="true">*</span></label>
                        <input id="mf-brand" class="form-control @(ShowError(BrandError) ? "is-invalid" : "")" @bind="_form.Brand" @bind:event="oninput"
                               placeholder="@L["material.form.brand.placeholder"]" autocomplete="off" aria-required="true" />
                        @if (ShowError(BrandError)) { <div class="invalid-feedback">@BrandError</div> }
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="mf-type">@L["material.type"] <span class="text-danger" aria-hidden="true">*</span></label>
                        <input id="mf-type" class="form-control @(ShowError(TypeError) ? "is-invalid" : "")" list="mf-type-list" @bind="_form.Type" @bind:event="oninput"
                               placeholder="PLA, PETG…" autocomplete="off" aria-required="true" />
                        <datalist id="mf-type-list">
                            @foreach (var t in TypePresets.Keys)
                            {
                                <option value="@t" />
                            }
                            <option value="Nylon" /><option value="HIPS" /><option value="PVA" /><option value="PLA+" /><option value="PLA Silk" /><option value="PETG-CF" /><option value="PA-CF" />
                        </datalist>
                        @if (ShowError(TypeError)) { <div class="invalid-feedback">@TypeError</div> }
                        <div class="mf-type-chips" role="group" aria-label="@L["material.form.type.quick"]">
                            @foreach (var t in TypePresets.Keys)
                            {
                                var type = t;
                                <button type="button" class="sh-chip" aria-pressed="@(string.Equals(_form.Type, type, StringComparison.OrdinalIgnoreCase) ? "true" : "false")"
                                        @onclick="() => PickType(type)">@type</button>
                            }
                        </div>
                        @if (_defaultsApplied != null)
                        {
                            <div class="form-text mf-defaults-note" role="status"><i class="bi bi-magic" aria-hidden="true"></i> @L.Format("material.form.defaults.applied", _defaultsApplied)</div>
                        }
                    </div>
                </div>

                <hr class="my-4" />

                <div class="mf-color">
                    <SpoolRing ColorHex="@_form.ColorHex" Percent="100" Size="88" AriaLabel="@L.Format("material.form.color.preview", "#" + _form.ColorHex)" />
                    <div class="flex-grow-1 min-w-0">
                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label class="form-label" for="mf-hex">@L["material.form.color"] <span class="text-danger" aria-hidden="true">*</span></label>
                                <div class="input-group has-validation">
                                    <input type="color" class="form-control form-control-color" aria-label="@L["material.form.color.picker"]"
                                           value="@("#" + (IsValidHex(_form.ColorHex) ? _form.ColorHex : "FFFFFF"))" @oninput="OnColorPick" />
                                    <span class="input-group-text">#</span>
                                    <input id="mf-hex" class="form-control font-monospace text-uppercase @(ShowError(HexError) ? "is-invalid" : "")" maxlength="7"
                                           value="@_form.ColorHex" @oninput="OnHexInput" placeholder="FFFFFF" autocomplete="off" spellcheck="false" />
                                    @if (ShowError(HexError)) { <div class="invalid-feedback">@HexError</div> }
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label" for="mf-colorname">@L["material.color.name"] <span class="text-muted fw-normal">@L["common.optional"]</span></label>
                                <input id="mf-colorname" class="form-control" @bind="_form.ColorName" placeholder="@L["material.form.colorname.placeholder"]" />
                            </div>
                        </div>
                        <div class="mf-presets" role="group" aria-label="@L["material.form.color.presets"]">
                            @foreach (var (hex, key) in ColorPresets)
                            {
                                var h = hex;
                                <button type="button" class="mf-preset @(string.Equals(_form.ColorHex, h, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                        style="--mf-swatch:#@h" title="@L[key]" aria-label="@L[key]"
                                        aria-pressed="@(string.Equals(_form.ColorHex, h, StringComparison.OrdinalIgnoreCase) ? "true" : "false")"
                                        @onclick="() => PickPreset(h, key)"></button>
                            }
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <fieldset>
                    <legend class="form-label mb-2">@L["material.diameter"]</legend>
                    <div class="sh-segmented" role="group">
                        <button type="button" aria-pressed="@(_form.DiameterMm == 1.75m ? "true" : "false")" @onclick="() => _form.DiameterMm = 1.75m">1.75 mm</button>
                        <button type="button" aria-pressed="@(_form.DiameterMm == 2.85m ? "true" : "false")" @onclick="() => _form.DiameterMm = 2.85m">2.85 mm</button>
                    </div>
                </fieldset>
            </section>

            @* Printing *@
            <section class="sh-card mf-section" aria-labelledby="mf-printing">
                <h2 class="sh-card-title" id="mf-printing">@L["material.form.section.printing"]</h2>
                <p class="sh-card-sub mb-3">@L["material.form.section.printing.hint"]</p>
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <label class="form-label" for="mf-min">@L["material.form.nozzle.min"]</label>
                        <div class="input-group">
                            <input id="mf-min" class="form-control @(ShowError(TempError) ? "is-invalid" : "")" type="number" min="0" max="500" inputmode="numeric" @bind="_form.MinTempCelsius" />
                            <span class="input-group-text">°C</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label" for="mf-max">@L["material.form.nozzle.max"]</label>
                        <div class="input-group">
                            <input id="mf-max" class="form-control @(ShowError(TempError) ? "is-invalid" : "")" type="number" min="0" max="500" inputmode="numeric" @bind="_form.MaxTempCelsius" />
                            <span class="input-group-text">°C</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label" for="mf-bed">@L["material.form.bed"] <span class="text-muted fw-normal">@L["common.optional"]</span></label>
                        <div class="input-group">
                            <input id="mf-bed" class="form-control" type="number" min="0" max="200" inputmode="numeric" @bind="_form.BedTempCelsius" />
                            <span class="input-group-text">°C</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label" for="mf-density">@L["material.form.density"] <span class="text-muted fw-normal">@L["common.optional"]</span></label>
                        <div class="input-group">
                            <input id="mf-density" class="form-control" type="number" step="0.01" min="0" inputmode="decimal" @bind="_form.DensityGCm3" />
                            <span class="input-group-text">g/cm³</span>
                        </div>
                    </div>
                    @if (ShowError(TempError))
                    {
                        <div class="col-12"><div class="text-danger small" role="alert">@TempError</div></div>
                    }
                </div>
            </section>

            @* Drying *@
            <section class="sh-card mf-section" aria-labelledby="mf-drying">
                <h2 class="sh-card-title" id="mf-drying">@L["material.form.section.drying"]</h2>
                <p class="sh-card-sub mb-3">@L["material.form.section.drying.hint"]</p>
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <label class="form-label" for="mf-drytemp">@L["material.form.dry.temp"]</label>
                        <div class="input-group">
                            <input id="mf-drytemp" class="form-control" type="number" min="0" max="150" inputmode="numeric" @bind="_form.DryTempCelsius" />
                            <span class="input-group-text">°C</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label" for="mf-drytime">@L["material.form.dry.time"]</label>
                        <div class="input-group">
                            <input id="mf-drytime" class="form-control" type="number" min="0" max="72" inputmode="numeric" @bind="_form.DryTimeHours" />
                            <span class="input-group-text">h</span>
                        </div>
                    </div>
                </div>
            </section>

            @* Spool & weight *@
            <section class="sh-card mf-section" aria-labelledby="mf-weight">
                <h2 class="sh-card-title" id="mf-weight">@L["material.form.section.weight"]</h2>
                <p class="sh-card-sub mb-3">@L["material.form.section.weight.hint"]</p>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="mf-net">@L["material.form.net.weight"]</label>
                        <div class="input-group">
                            <input id="mf-net" class="form-control" type="number" min="0" inputmode="numeric" @bind="_form.WeightGrams" placeholder="1000" />
                            <span class="input-group-text">g</span>
                        </div>
                        <div class="form-text">@L["material.form.net.weight.hint"]</div>
                        <div class="mf-quick" role="group" aria-label="@L["material.form.net.weight"]">
                            @foreach (var w in new[] { 250, 500, 750, 1000, 2000 })
                            {
                                var grams = w;
                                <button type="button" class="sh-chip" aria-pressed="@(_form.WeightGrams == grams ? "true" : "false")" @onclick="() => _form.WeightGrams = grams">@(grams >= 1000 ? $"{grams / 1000} kg" : $"{grams} g")</button>
                            }
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="mf-spoolw">@L["material.spool.weight"]</label>
                        <div class="input-group">
                            <input id="mf-spoolw" class="form-control" type="number" min="0" inputmode="numeric" @bind="_form.SpoolWeightGrams" placeholder="200" />
                            <span class="input-group-text">g</span>
                        </div>
                        <div class="form-text">@L["material.spool.weight.hint"]</div>
                    </div>
                </div>
            </section>

            @* Price & reorder *@
            <section class="sh-card mf-section" aria-labelledby="mf-price">
                <h2 class="sh-card-title" id="mf-price">@L["material.form.section.price"]</h2>
                <p class="sh-card-sub mb-3">@L["material.form.section.price.hint"]</p>
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="mf-pricekg">@L["material.form.price"]</label>
                        <div class="input-group">
                            <input id="mf-pricekg" class="form-control" type="number" step="0.01" min="0" inputmode="decimal" @bind="_form.PricePerKg" />
                            <span class="input-group-text">€/kg</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-8">
                        <label class="form-label" for="mf-reorder">@L["material.reorder"]</label>
                        <input id="mf-reorder" class="form-control @(ShowError(UrlError) ? "is-invalid" : "")" type="url" inputmode="url" @bind="_form.ReorderUrl" placeholder="https://…" />
                        @if (ShowError(UrlError)) { <div class="invalid-feedback">@UrlError</div> }
                        else { <div class="form-text">@L["material.form.reorder.hint"]</div> }
                    </div>
                </div>
            </section>

            @* Notes & sharing *@
            <section class="sh-card mf-section" aria-labelledby="mf-notes">
                <h2 class="sh-card-title" id="mf-notes">@L["material.form.section.notes"]</h2>
                <label class="visually-hidden" for="mf-notes-input">@L["material.notes"]</label>
                <textarea id="mf-notes-input" class="form-control mt-2" rows="3" @bind="_form.Notes" placeholder="@L["material.form.notes.placeholder"]"></textarea>

                <div class="form-check form-switch mt-4 mf-switch">
                    <input type="checkbox" class="form-check-input" role="switch" id="mf-public" @bind="_form.IsPublic" aria-describedby="mf-public-hint" />
                    <label class="form-check-label fw-semibold" for="mf-public">@L["material.form.public"]</label>
                    <div class="form-text" id="mf-public-hint">@L["material.form.public.hint"]</div>
                </div>
            </section>
        </div>

        <aside class="mf-side" aria-label="@L["material.form.preview"]">
            <div class="sh-card mf-preview">
                <div class="mf-preview-head">
                    <SpoolRing ColorHex="@_form.ColorHex" Percent="100" Size="64" />
                    <div class="min-w-0">
                        <div class="small text-muted text-truncate">@(string.IsNullOrWhiteSpace(_form.Brand) ? L["material.brand"] : _form.Brand)</div>
                        <div class="fw-semibold mf-preview-title">@(string.IsNullOrWhiteSpace(_form.Type) ? L["material.type"] : _form.Type)</div>
                        <div class="small text-muted text-truncate">@(string.IsNullOrWhiteSpace(_form.ColorName) ? "#" + _form.ColorHex : _form.ColorName)</div>
                    </div>
                </div>
                <dl class="mf-preview-kv">
                    <div><dt>@L["material.col.temps"]</dt><dd>@(_form.MinTempCelsius > 0 || _form.MaxTempCelsius > 0 ? $"{_form.MinTempCelsius}–{_form.MaxTempCelsius} °C" : "–")</dd></div>
                    <div><dt>@L["material.bed.short"]</dt><dd>@(_form.BedTempCelsius is > 0 ? $"{_form.BedTempCelsius} °C" : "–")</dd></div>
                    <div><dt>Ø</dt><dd>@_form.DiameterMm.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) mm</dd></div>
                    <div><dt>@L["material.form.dry.short"]</dt><dd>@(_form.DryTempCelsius is > 0 ? $"{_form.DryTempCelsius} °C · {_form.DryTimeHours ?? 0} h" : "–")</dd></div>
                </dl>

                <div class="mf-submit">
                    <button type="submit" class="btn btn-primary" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                        else { <i class="bi bi-check-lg" aria-hidden="true"></i> }
                        @(Id.HasValue ? L["material.form.save.changes"] : L["material.form.save.new"])
                    </button>
                    <a href="/materials" class="btn btn-outline-secondary">@L["common.cancel"]</a>
                </div>

                @if (_error != null)
                {
                    <div class="alert alert-danger py-2 mb-0" role="alert">@_error</div>
                }
                @if (_submitted && !IsValid)
                {
                    <div class="alert alert-warning py-2 mb-0" role="alert">@L["material.form.fix.errors"]</div>
                }
            </div>
        </aside>
    </form>
}

@page "/materials/share"

<PageTitle>@L["material.share"] – @L["app.name"]</PageTitle>

<div class="page-header">
    <div>
        <h1>@L["material.share"]</h1>
        <p class="page-subtitle">@L["material.share.subtitle"]</p>
    </div>
    <div class="page-actions">
        <a href="/materials" class="btn btn-outline-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i>@L["material.form.back"]</a>
    </div>
</div>

<div class="sh-segmented share-tabs mb-3" role="group" aria-label="@L["material.share"]">
    <button type="button" aria-pressed="@(!_importTab ? "true" : "false")" @onclick="() => _importTab = false">
        <i class="bi bi-box-arrow-up" aria-hidden="true"></i>@L["material.share.tab.export"]
    </button>
    <button type="button" aria-pressed="@(_importTab ? "true" : "false")" @onclick="() => _importTab = true">
        <i class="bi bi-box-arrow-in-down" aria-hidden="true"></i>@L["material.share.tab.import"]
    </button>
</div>

@if (!_importTab)
{
    <div class="share-grid">
        <section class="sh-card" aria-labelledby="share-step1">
            <div class="share-step"><span class="share-step-no" aria-hidden="true">1</span>
                <div>
                    <h2 class="sh-card-title" id="share-step1">@L["material.share.step.pick"]</h2>
                    <p class="sh-card-sub">@L["material.share.step.pick.hint"]</p>
                </div>
            </div>

            <h3 class="share-subhead">@L["material.export.orca.from.spools"]</h3>
            <SpoolMaterialQuickPick SelectedIds="SelectedIds" OnAdd="AddByIdAsync" OnRemove="Remove" />

            <h3 class="share-subhead">@L["material.share.search"]</h3>
            <MaterialPicker Value="_exportPickerId" OnSelected="OnExportPicked" />
        </section>

        <section class="sh-card" aria-labelledby="share-step2">
            <div class="share-step"><span class="share-step-no" aria-hidden="true">2</span>
                <div>
                    <h2 class="sh-card-title" id="share-step2">@L["material.share.step.code"]</h2>
                    <p class="sh-card-sub">@L["material.share.step.code.hint"]</p>
                </div>
            </div>

            <SelectedMaterials Items="_selectedMaterials" OnRemove="Remove" EmptyText="@L["material.share.none.selected"]" />

            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="button" class="btn btn-primary" @onclick="ExportAsync" disabled="@(_selectedMaterials.Count == 0 || _exporting)">
                    @if (_exporting) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                    else { <i class="bi bi-qr-code" aria-hidden="true"></i> }
                    @L.Format("material.share.create", _selectedMaterials.Count)
                </button>
                @if (_selectedMaterials.Count > 0)
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="ClearSelection">@L["common.clear"]</button>
                }
            </div>

            @if (_exportError != null)
            {
                <div class="alert alert-danger py-2 mt-3" role="alert">@_exportError</div>
            }

            @if (_exportBase64 != null)
            {
                <div class="share-result mt-3">
                    <label class="form-label" for="share-code">@L["material.share.code.label"]</label>
                    <textarea id="share-code" class="form-control font-monospace share-code" rows="5" readonly>@_exportBase64</textarea>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <button type="button" class="btn btn-outline-primary" @onclick="CopyExportAsync">
                            <i class="bi @(_copied ? "bi-check-lg" : "bi-clipboard")" aria-hidden="true"></i>@(_copied ? L["material.export.copied"] : L["material.export.copy"])
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="DownloadExportAsync">
                            <i class="bi bi-download" aria-hidden="true"></i>@L["material.share.download"]
                        </button>
                    </div>
                    <span class="visually-hidden" role="status">@(_copied ? L["material.export.copied"] : "")</span>
                </div>
            }
        </section>
    </div>
}
else
{
    <section class="sh-card share-import" aria-labelledby="share-import-title">
        <h2 class="sh-card-title" id="share-import-title">@L["material.import"]</h2>
        <p class="sh-card-sub mb-3">@L["material.share.import.hint"]</p>

        @if (_importSuccess != null)
        {
            <div class="alert alert-success d-flex flex-wrap align-items-center gap-2" role="status">
                <i class="bi bi-check-circle" aria-hidden="true"></i>
                <span class="flex-grow-1">@_importSuccess</span>
                <a class="btn btn-sm btn-success" href="/materials">@L["material.share.import.view"]</a>
            </div>
        }

        <label class="form-label" for="share-import-code">@L["material.import.paste"]</label>
        <textarea id="share-import-code" class="form-control font-monospace share-code" rows="6" @bind="_importBase64" @bind:event="oninput" placeholder="eyJWZXJzaW9uIjox…"></textarea>

        <div class="share-file mt-2">
            <span class="text-muted small">@L["material.share.import.or"]</span>
            <label class="btn btn-outline-secondary btn-sm mb-0">
                <i class="bi bi-file-earmark-arrow-up" aria-hidden="true"></i>@L["material.share.import.file"]
                <InputFile class="visually-hidden" accept=".txt,.b64,text/plain" OnChange="OnImportFileAsync" />
            </label>
        </div>

        @if (_importError != null)
        {
            <div class="alert alert-danger py-2 mt-3" role="alert">@_importError</div>
        }

        <button type="button" class="btn btn-primary mt-3" @onclick="DoImportAsync" disabled="@(string.IsNullOrWhiteSpace(_importBase64) || _importing)">
            @if (_importing) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
            else { <i class="bi bi-box-arrow-in-down" aria-hidden="true"></i> }
            @L["material.share.import.button"]
        </button>
    </section>
}

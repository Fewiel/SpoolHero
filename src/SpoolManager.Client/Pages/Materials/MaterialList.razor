@page "/materials"

<PageTitle>@L["material.title"] – @L["app.name"]</PageTitle>

<div class="page-header">
    <div>
        <h1>@L["material.title"]</h1>
        <p class="page-subtitle">@L["material.list.subtitle"]</p>
    </div>
    <div class="page-actions">
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-arrow-left-right" aria-hidden="true"></i>@L["material.list.more"]
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/materials/share"><i class="bi bi-share" aria-hidden="true"></i>@L["material.share"]</a></li>
                <li><a class="dropdown-item" href="/materials/orca"><i class="bi bi-box-seam" aria-hidden="true"></i>@L["material.export.orca"]</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/materials/suggest"><i class="bi bi-lightbulb" aria-hidden="true"></i>@L["material.suggest.new"]</a></li>
            </ul>
        </div>
        <a class="btn btn-primary" href="/materials/new">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>@L["material.add"]
        </a>
    </div>
</div>

<div class="mat-scope">
    <div class="sh-segmented" role="group" aria-label="@L["material.scope.label"]">
        <button type="button" aria-pressed="@(_scope == "" ? "true" : "false")" @onclick='() => SetScopeAsync("")'>
            <i class="bi bi-collection" aria-hidden="true"></i>@L["material.scope.all"]
        </button>
        <button type="button" aria-pressed="@(_scope == "project" ? "true" : "false")" @onclick='() => SetScopeAsync("project")'>
            <i class="bi bi-folder2" aria-hidden="true"></i>@L["material.scope.project"]
        </button>
        <button type="button" aria-pressed="@(_scope == "global" ? "true" : "false")" @onclick='() => SetScopeAsync("global")'>
            <i class="bi bi-globe2" aria-hidden="true"></i>@L["material.scope.global"]
        </button>
    </div>
    <p class="mat-scope-hint">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
        @(_scope switch
        {
            "project" => L["material.scope.project.hint"],
            "global" => L["material.scope.global.hint"],
            _ => L["material.scope.all.hint"]
        })
    </p>
</div>

<div class="sh-toolbar mat-toolbar">
    <div class="mat-filter">
        <label class="visually-hidden" for="mat-type">@L["material.type"]</label>
        <select id="mat-type" class="form-select" value="@_typeFilter" @onchange="OnTypeChanged">
            <option value="">@L["material.filter.type.all"]</option>
            @foreach (var t in _types)
            {
                <option value="@t">@t</option>
            }
        </select>
    </div>
    <div class="mat-filter">
        <label class="visually-hidden" for="mat-brand">@L["material.brand"]</label>
        <input id="mat-brand" type="search" class="form-control" list="brand-list" placeholder="@L["material.filter.brand"]"
               value="@_brandFilter" @oninput="OnBrandChanged" autocomplete="off" />
        <datalist id="brand-list">
            @foreach (var b in _brands)
            {
                <option value="@b" />
            }
        </datalist>
    </div>
    <div class="mat-filter">
        <label class="visually-hidden" for="mat-color">@L["material.filter.color.label"]</label>
        <input id="mat-color" type="search" class="form-control" list="color-list" placeholder="@L["material.filter.color"]"
               value="@_colorFilter" @oninput="OnColorChanged" autocomplete="off" />
        <datalist id="color-list">
            @foreach (var c in _colors)
            {
                <option value="@c" />
            }
        </datalist>
    </div>
    <div class="mat-chips">
        <button type="button" class="sh-chip" aria-pressed="@(_favoritesOnly ? "true" : "false")" @onclick="OnFavoritesFilterChanged">
            <i class="bi @(_favoritesOnly ? "bi-star-fill" : "bi-star")" aria-hidden="true"></i>@L["material.filter.favorites.chip"]
        </button>
        <button type="button" class="sh-chip" aria-pressed="@(_onSpoolOnly ? "true" : "false")" @onclick="OnSpoolFilterChanged">
            <i class="bi bi-record-circle" aria-hidden="true"></i>@L["material.filter.onspool"]
        </button>
    </div>
    <div class="mat-sort d-md-none">
        <label class="visually-hidden" for="mat-sort">@L["material.sort.label"]</label>
        <select id="mat-sort" class="form-select" value="@SortKey" @onchange="OnSortSelected">
            <option value="spool:desc">@L["material.sort.spool"]</option>
            <option value="brand:asc">@L["material.sort.brand"]</option>
            <option value="type:asc">@L["material.sort.type"]</option>
            <option value="temp:asc">@L["material.sort.temp"]</option>
            <option value="diameter:asc">@L["material.sort.diameter"]</option>
        </select>
    </div>
</div>

@if (_error != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        <span class="flex-grow-1">@_error</span>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync">@L["material.retry"]</button>
    </div>
}

@if (_loading && _items.Length == 0)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">@L["common.loading"]</span></div></div>
}
else if (_totalCount == 0)
{
    <div class="sh-empty">
        @if (HasFilters)
        {
            <i class="bi bi-funnel" aria-hidden="true"></i>
            <h2>@L["material.empty.filtered.title"]</h2>
            <p>@L["material.empty.filtered.text"]</p>
            <button type="button" class="btn btn-primary mt-2" @onclick="ClearFiltersAsync">
                <i class="bi bi-x-lg" aria-hidden="true"></i>@L["material.filter.clear"]
            </button>
        }
        else
        {
            <i class="bi bi-palette2" aria-hidden="true"></i>
            <h2>@L["material.empty.title"]</h2>
            <p>@(_scope == "project" ? L["material.empty.project.text"] : L["material.empty.text"])</p>
            <a class="btn btn-primary mt-2" href="/materials/new"><i class="bi bi-plus-lg" aria-hidden="true"></i>@L["material.add"]</a>
        }
    </div>
}
else
{
    <div class="mat-resultbar" aria-live="polite">
        <span>
            <strong>@_totalCount</strong> @L["admin.materials.total"]
            @if (TotalPages > 1)
            {
                <span class="text-muted"> · @L.Format("material.page.of", _page + 1, TotalPages)</span>
            }
        </span>
        @if (_loading)
        {
            <span class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">@L["common.loading"]</span></span>
        }
        @if (HasFilters)
        {
            <button type="button" class="btn btn-link btn-sm ms-auto" @onclick="ClearFiltersAsync">
                <i class="bi bi-x-lg" aria-hidden="true"></i>@L["material.filter.clear"]
            </button>
        }
    </div>

    @* Desktop: dense, sortable table *@
    <div class="table-responsive d-none d-md-block mat-table @(_loading ? "mat-busy" : "")">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">@L["material.col.material"]</th>
                    <th scope="col" aria-sort="@AriaSort("type")">
                        <button type="button" class="mat-sort-btn" @onclick='() => SetSort("type")'>@L["material.type"]<i class="bi @SortIcon("type")" aria-hidden="true"></i></button>
                    </th>
                    <th scope="col" aria-sort="@AriaSort("brand")">
                        <button type="button" class="mat-sort-btn" @onclick='() => SetSort("brand")'>@L["material.brand"]<i class="bi @SortIcon("brand")" aria-hidden="true"></i></button>
                    </th>
                    <th scope="col" aria-sort="@AriaSort("temp")">
                        <button type="button" class="mat-sort-btn" @onclick='() => SetSort("temp")'>@L["material.col.temps"]<i class="bi @SortIcon("temp")" aria-hidden="true"></i></button>
                    </th>
                    <th scope="col" aria-sort="@AriaSort("diameter")">
                        <button type="button" class="mat-sort-btn" @onclick='() => SetSort("diameter")'>Ø<i class="bi @SortIcon("diameter")" aria-hidden="true"></i></button>
                    </th>
                    <th scope="col" aria-sort="@AriaSort("spool")">
                        <button type="button" class="mat-sort-btn" @onclick='() => SetSort("spool")'>@L["material.col.status"]<i class="bi @SortIcon("spool")" aria-hidden="true"></i></button>
                    </th>
                    <th scope="col" class="text-end">@L["common.actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in _items)
                {
                    <tr @key="m.Id">
                        <td>
                            <div class="mat-ident">
                                <SpoolRing ColorHex="@m.ColorHex" Percent="100" Size="36" />
                                <div class="min-w-0">
                                    <div class="fw-semibold text-truncate">@(m.ColorName ?? "#" + m.ColorHex)</div>
                                    <div class="small text-muted font-monospace">#@m.ColorHex</div>
                                </div>
                            </div>
                        </td>
                        <td class="fw-semibold">@m.Type</td>
                        <td>@m.Brand</td>
                        <td class="text-nowrap">
                            @TempText(m)
                            @if (m.BedTempCelsius is > 0)
                            {
                                <div class="small text-muted">@L["material.bed.short"] @m.BedTempCelsius °C</div>
                            }
                        </td>
                        <td class="text-nowrap">@m.DiameterMm.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) mm</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @if (m.HasActiveSpool)
                                {
                                    <span class="sh-chip sh-chip-sm sh-chip-ok"><i class="bi bi-record-circle" aria-hidden="true"></i>@L["material.chip.onspool"]</span>
                                }
                                <span class="sh-chip sh-chip-sm @(m.IsGlobal ? "" : "sh-chip-accent")" title="@SourceHint(m)"><i class="bi @(m.IsGlobal ? "bi-globe2" : "bi-folder2")" aria-hidden="true"></i>@SourceLabel(m)</span>
                            </div>
                        </td>
                        <td class="text-end">
                            <div class="mat-actions">
                                <MaterialRowActions Material="m" Compact="true" IsFavorite="Favorites.IsFavorite(m.Id)" OnToggleFavorite="() => ToggleFavorite(m.Id)" OnDelete="() => ConfirmDelete(m)" OnReorder="() => TrackReorder(m.Id)" />
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Phone: cards *@
    <ul class="mat-cards d-md-none @(_loading ? "mat-busy" : "")" role="list">
        @foreach (var m in _items)
        {
            <li class="mat-card" @key="m.Id">
                <div class="mat-card-head">
                    <SpoolRing ColorHex="@m.ColorHex" Percent="100" Size="48" />
                    <div class="min-w-0 flex-grow-1">
                        <div class="small text-muted text-truncate">@m.Brand · @m.Type</div>
                        <div class="fw-semibold text-truncate">@(m.ColorName ?? "#" + m.ColorHex)</div>
                        <div class="small text-muted">
                            @TempText(m) · @m.DiameterMm.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) mm
                        </div>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-1">
                    @if (m.HasActiveSpool)
                    {
                        <span class="sh-chip sh-chip-sm sh-chip-ok"><i class="bi bi-record-circle" aria-hidden="true"></i>@L["material.chip.onspool"]</span>
                    }
                    <span class="sh-chip sh-chip-sm @(m.IsGlobal ? "" : "sh-chip-accent")" title="@SourceHint(m)"><i class="bi @(m.IsGlobal ? "bi-globe2" : "bi-folder2")" aria-hidden="true"></i>@SourceLabel(m)</span>
                </div>
                <div class="mat-actions mat-actions-lg">
                    <MaterialRowActions Material="m" Compact="false" IsFavorite="Favorites.IsFavorite(m.Id)" OnToggleFavorite="() => ToggleFavorite(m.Id)" OnDelete="() => ConfirmDelete(m)" OnReorder="() => TrackReorder(m.Id)" />
                </div>
            </li>
        }
    </ul>

    @if (TotalPages > 1)
    {
        <nav class="mt-3 d-flex justify-content-center" aria-label="@L["material.pagination"]">
            <ul class="pagination mb-0 flex-wrap">
                <li class="page-item @(_page == 0 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => SetPage(0)" aria-label="@L["material.page.first"]"><i class="bi bi-chevron-bar-left" aria-hidden="true"></i></button>
                </li>
                <li class="page-item @(_page == 0 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => SetPage(_page - 1)" aria-label="@L["material.page.prev"]"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
                </li>
                @foreach (var p in VisiblePages)
                {
                    <li class="page-item @(p == _page ? "active" : "")">
                        <button class="page-link" @onclick="() => SetPage(p)" aria-current="@(p == _page ? "page" : null)">@(p + 1)</button>
                    </li>
                }
                <li class="page-item @(_page >= TotalPages - 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => SetPage(_page + 1)" aria-label="@L["material.page.next"]"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </li>
                <li class="page-item @(_page >= TotalPages - 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => SetPage(TotalPages - 1)" aria-label="@L["material.page.last"]"><i class="bi bi-chevron-bar-right" aria-hidden="true"></i></button>
                </li>
            </ul>
        </nav>
    }
}

@if (_deleteTarget != null)
{
    <div class="modal-backdrop-custom" @onclick="() => _deleteTarget = null">
        <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="mat-del-title" @onclick:stopPropagation>
            <h5 id="mat-del-title">@L["material.delete"]</h5>
            <div class="mat-ident my-3">
                <SpoolRing ColorHex="@_deleteTarget.ColorHex" Percent="100" Size="44" />
                <div>
                    <div class="fw-semibold">@_deleteTarget.Brand @_deleteTarget.Type</div>
                    <div class="small text-muted">@(_deleteTarget.ColorName ?? "#" + _deleteTarget.ColorHex)</div>
                </div>
            </div>
            <p class="text-muted">@L["material.delete.explain"]</p>
            @if (_deleteError != null)
            {
                <div class="alert alert-danger py-2">@_deleteError</div>
            }
            <div class="d-flex gap-2 justify-content-end flex-wrap">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => _deleteTarget = null">@L["common.cancel"]</button>
                <button type="button" class="btn btn-danger" @onclick="DeleteAsync" disabled="@_deleting">
                    @if (_deleting) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                    <i class="bi bi-trash" aria-hidden="true"></i>@L["material.delete.button"]
                </button>
            </div>
        </div>
    </div>
}

<PageTitle>@L["notfound.title"] – @L["app.name"]</PageTitle>

<PublicShell Variant="auth" BypassWhenAuthenticated="true">
    <div class="sh-nf">
        <SpoolRing ColorHex="@null" Percent="0" Size="120">404</SpoolRing>
        <h1>@L["notfound.title"]</h1>
        <p>@L["notfound.text"]</p>
        <div class="sh-nf-actions">
            @if (Auth.IsAuthenticated)
            {
                <a href="/" class="btn btn-primary"><i class="bi bi-house" aria-hidden="true"></i>@L["notfound.home"]</a>
                <a href="/spools" class="btn btn-outline-secondary"><i class="bi bi-record-circle" aria-hidden="true"></i>@L["notfound.spools"]</a>
            }
            else
            {
                <a href="/login" class="btn btn-primary"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>@L["notfound.login"]</a>
            }
        </div>
    </div>
</PublicShell>

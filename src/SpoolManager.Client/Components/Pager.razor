@if (TotalItems > 0)
{
    <div class="sh-pager">
        <p class="sh-pager-info mb-0" aria-live="polite">@L.Format("pager.range", First, Last, TotalItems)</p>
        @if (TotalPages > 1)
        {
            <nav aria-label="@L["pager.label"]">
                <ul class="pagination mb-0">
                    <li class="page-item @(Page == 0 ? "disabled" : "")">
                        <button type="button" class="page-link" @onclick="() => GoAsync(Page - 1)" disabled="@(Page == 0)" aria-label="@L["pager.previous"]">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        </button>
                    </li>
                    @foreach (var p in VisiblePages)
                    {
                        var page = p;
                        <li class="page-item d-none d-sm-block @(page == Page ? "active" : "")">
                            <button type="button" class="page-link" @onclick="() => GoAsync(page)" aria-current="@(page == Page ? "page" : null)"
                                    aria-label="@L.Format("pager.page", page + 1)">@(page + 1)</button>
                        </li>
                    }
                    <li class="page-item d-sm-none active">
                        <span class="page-link">@(Page + 1) / @TotalPages</span>
                    </li>
                    <li class="page-item @(Page >= TotalPages - 1 ? "disabled" : "")">
                        <button type="button" class="page-link" @onclick="() => GoAsync(Page + 1)" disabled="@(Page >= TotalPages - 1)" aria-label="@L["pager.next"]">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

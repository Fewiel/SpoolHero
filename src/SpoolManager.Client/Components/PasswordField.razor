<div class="input-group sh-password @(Invalid ? "has-validation" : "")">
    <input id="@Id" class="form-control @(Invalid ? "is-invalid" : "")" type="@(_visible ? "text" : "password")"
           value="@Value" @oninput="OnInput" autocomplete="@Autocomplete" required="@Required"
           aria-invalid="@(Invalid ? "true" : null)" aria-describedby="@DescribedBy" />
    <button type="button" class="btn btn-outline-secondary sh-password-toggle" @onclick="Toggle"
            aria-label="@(_visible ? L["auth.password.hide"] : L["auth.password.show"])"
            aria-pressed="@(_visible ? "true" : "false")" aria-controls="@Id">
        <i class="bi @(_visible ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
    </button>
    @ChildContent
</div>

@if (_visible)
{
    <div class="modal-backdrop-custom" @onclick="CloseAsync">
        <div class="modal-box find-box" role="dialog" aria-modal="true" aria-labelledby="find-spool-title" @onclick:stopPropagation>
            <div class="d-flex align-items-start justify-content-between gap-2">
                <h5 id="find-spool-title" class="mb-0">@L["spool.find.title"]</h5>
                <button type="button" class="btn-close" @onclick="CloseAsync" aria-label="@L["common.close"]"></button>
            </div>

            <div class="find-target">
                <SpoolRing ColorHex="@Spool.MaterialColorHex" Percent="Spool.RemainingPercent" Size="44" />
                <div class="min-w-0">
                    <div class="fw-semibold text-truncate">@Spool.MaterialBrand @Spool.MaterialType @Spool.MaterialColorName</div>
                    <div class="small text-muted">#@Spool.Id.ToString("N")[..5].ToUpperInvariant()</div>
                </div>
            </div>

            <div class="find-state find-@_state.ToString().ToLowerInvariant()" role="status" aria-live="polite">
                @if (_state == FindState.Found)
                {
                    <span class="find-icon" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                    <p class="fw-semibold mb-0">@L["spool.find.found"]</p>
                }
                else if (_state == FindState.Mismatch)
                {
                    <span class="find-icon" aria-hidden="true"><i class="bi bi-x-lg"></i></span>
                    <p class="fw-semibold mb-0">@L["spool.find.wrong"]</p>
                    <p class="small text-muted mb-0">@L["spool.find.retry"]</p>
                }
                else
                {
                    <span class="find-icon nfc-pulse-icon" aria-hidden="true"><i class="bi bi-broadcast"></i></span>
                    <p class="text-muted mb-0">@L["spool.find.scanning"]</p>
                }
            </div>

            @if (_state != FindState.Found)
            {
                <div class="d-flex justify-content-end">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseAsync">@L["common.cancel"]</button>
                </div>
            }
        </div>
    </div>
}

<div class="sh-segmented w-100" role="group" aria-label="@L["nav.language"]" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr))">
    <button type="button" aria-pressed="@(L.CurrentLanguage == "de" ? "true" : "false")" lang="de" @onclick='() => SetLang("de")' style="justify-content:center">Deutsch</button>
    <button type="button" aria-pressed="@(L.CurrentLanguage == "en" ? "true" : "false")" lang="en" @onclick='() => SetLang("en")' style="justify-content:center">English</button>
</div>

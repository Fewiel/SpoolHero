<div class="mp" @ref="_root" @onkeydown="OnKeyDown">
    <button type="button" class="mp-trigger form-select @(Invalid ? "is-invalid" : "") @(_open ? "mp-open" : "")" @onclick="Toggle"
            aria-haspopup="listbox" aria-expanded="@(_open ? "true" : "false")" aria-labelledby="@AriaLabelledBy">
        @if (_selectedMaterial != null)
        {
            <span class="sh-color-swatch mp-swatch" style="background:#@_selectedMaterial.ColorHex" aria-hidden="true"></span>
            <span class="mp-trigger-text">
                <span class="fw-semibold">@_selectedMaterial.Brand @_selectedMaterial.Type</span>
                <span class="text-muted">@(_selectedMaterial.ColorName ?? "#" + _selectedMaterial.ColorHex)</span>
            </span>
        }
        else
        {
            <span class="text-muted mp-trigger-text">@L["spool.material.select"]</span>
        }
    </button>

    @if (_open)
    {
        <div class="mp-panel">
            <div class="mp-search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input class="form-control" type="search" placeholder="@L["material.search"]" aria-label="@L["material.search"]"
                       @ref="_searchInput" value="@_query" @oninput="OnQuery" autocomplete="off" />
            </div>
            <div class="mp-list" role="listbox" aria-label="@L["spool.material"]">
                @if (_searching)
                {
                    <div class="text-center py-3"><div class="spinner-border spinner-border-sm" role="status"><span class="visually-hidden">@L["common.loading"]</span></div></div>
                }
                else if (string.IsNullOrWhiteSpace(_query))
                {
                    @if (_favorites.Count > 0)
                    {
                        <div class="mp-group">@L["material.favorites"]</div>
                        @foreach (var m in _favorites)
                        {
                            <button type="button" class="mp-item @(m.Id == Value ? "mp-selected" : "")" role="option" aria-selected="@(m.Id == Value ? "true" : "false")"
                                    @onclick="() => Select(m)" @onclick:stopPropagation>
                                <span class="sh-color-swatch mp-swatch-lg" style="background:#@m.ColorHex" aria-hidden="true"></span>
                                <span class="mp-item-text">
                                    <span class="fw-semibold">@m.Brand @m.Type</span>
                                    <span class="small text-muted">@(m.ColorName ?? $"#{m.ColorHex}")</span>
                                </span>
                                <i class="bi bi-star-fill mp-star" aria-hidden="true"></i>
                            </button>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-3 px-3 small">@L["material.picker.hint"]</div>
                    }
                }
                else if (_results.Count == 0)
                {
                    <div class="text-center text-muted py-3 px-3 small">
                        @L["material.picker.nomatch"]
                        <div class="mt-2"><a href="/materials">@L["material.picker.manage"]</a></div>
                    </div>
                }
                else
                {
                    @foreach (var m in _results)
                    {
                        <button type="button" class="mp-item @(m.Id == Value ? "mp-selected" : "")" role="option" aria-selected="@(m.Id == Value ? "true" : "false")"
                                @onclick="() => Select(m)" @onclick:stopPropagation>
                            <span class="sh-color-swatch mp-swatch-lg" style="background:#@m.ColorHex" aria-hidden="true"></span>
                            <span class="mp-item-text">
                                <span class="fw-semibold">@m.Brand @m.Type</span>
                                <span class="small text-muted">
                                    @(m.ColorName ?? $"#{m.ColorHex}")
                                    @if (m.MinTempCelsius > 0 || m.MaxTempCelsius > 0)
                                    {
                                        <span> · @m.MinTempCelsius–@m.MaxTempCelsius °C</span>
                                    }
                                </span>
                            </span>
                            @if (m.Id == Value)
                            {
                                <i class="bi bi-check-lg mp-check" aria-hidden="true"></i>
                            }
                        </button>
                    }
                }
            </div>
        </div>
    }
</div>
